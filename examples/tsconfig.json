{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["vite/client"]
  },
  "include": [
    "*.ts",
    "blender-loader/*.ts",
    "quickstart/*.ts",
    "skinning-ik/*.ts",
    "usdz-loader/*.ts",
    "webxr-orbit/*.ts"
  ]
}
