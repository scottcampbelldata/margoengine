{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["vite/client"]
  },
  "include": [
    "*.ts",
    "biomes/*.ts",
    "blender-loader/*.ts",
    "boulder/*.ts",
    "cad-viewer/*.ts",
    "cathedral-light/*.ts",
    "gallery/*.ts",
    "molten-words/*.ts",
    "orrery/*.ts",
    "quickstart/*.ts",
    "storm-light/*.ts",
    "test-pages/*.ts",
    "usdz-loader/*.ts",
    "webxr-orbit/*.ts",
    "xr-device-check/*.ts"
  ]
}
