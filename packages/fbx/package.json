{
  "name": "@margoengine/fbx",
  "version": "1.0.0",
  "description": "Binary and ASCII FBX conversion into the optional Margo glTF animation pipeline.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "fbx"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/fbx"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./scene-extras": {
      "types": "./dist/scene-extras.d.ts",
      "import": "./dist/scene-extras.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js"
    },
    "./pbr": {
      "types": "./dist/pbr.d.ts",
      "import": "./dist/pbr.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/exporters": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/geometry": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js fbx",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
