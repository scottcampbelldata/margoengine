{
  "name": "@margoengine/transitions",
  "version": "1.0.0",
  "description": "WebGPU scene wipes, noise dissolves and chromatic displacement.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "transitions"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/transitions"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js"
    },
    "./custom": {
      "types": "./dist/custom.d.ts",
      "import": "./dist/custom.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js transitions",
    "test": "npm run build && node --test --test-timeout=60000 test/*.test.js",
    "test:gpu": "node scripts/test-gpu.mjs",
    "prepack": "npm run build"
  }
}
