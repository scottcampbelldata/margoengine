{
  "name": "@margoengine/voxel-net",
  "version": "1.0.0",
  "description": "Multiplayer voxel worlds: an authoritative Node server on a hand-written WebSocket, a browser client with prediction and correction, and headless bots for load tests.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel",
    "net"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel-net"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./bot": {
      "types": "./dist/bot.d.ts",
      "import": "./dist/bot.js"
    },
    "./file-store": {
      "types": "./dist/file-store.d.ts",
      "import": "./dist/file-store.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./dist/entities.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/net": "^1.0.0",
    "@margoengine/voxel": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel-net",
    "test": "npm run build && node --test tests/*.test.js",
    "bench": "node bench/run.mjs",
    "prepack": "npm run build"
  }
}
