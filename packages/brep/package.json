{
  "name": "@margoengine/brep",
  "version": "1.0.0",
  "description": "Margo's own CAD kernel: STEP (ISO 10303-21) reading, product structure, units and colours, exact B-rep geometry (analytic surfaces and NURBS) and crack-free tessellation.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "cad",
    "b-rep",
    "step",
    "nurbs",
    "tessellation",
    "jt"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/brep"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js brep",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
