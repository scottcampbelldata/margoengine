  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/quality"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./warm": {
      "types": "./dist/warm.d.ts",
      "import": "./dist/warm.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
