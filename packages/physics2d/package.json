{
  "name": "@margoengine/physics2d",
  "version": "1.0.0",
  "description": "2D rigid-body physics for Margo Engine on its own 2D kernel (Rust to Wasm): fixed-step plugin with interpolation, sprite-driven bodies, joints, queries, events, a character controller and tile map colliders.",
  "keywords": [
    "margoengine",
    "webgpu",
    "2d",
    "physics",
    "wasm"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/physics2d"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu:kernel-browsers": "cd ../.. && npm run test:physics2d-kernel-browsers"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./outline": {
      "types": "./dist/outline.d.ts",
      "import": "./dist/outline.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/geometry": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
