{
  "name": "@margoengine/dof",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Optional two-pass WebGPU depth of field with circular bokeh.",
  "sideEffects": false,
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "files": ["dist", "LICENSE"],
  "publishConfig": {"access": "public"},
  "peerDependencies": {"@margoengine/core": "^1.0.0"},
  "scripts": {
    "build": "node ../../scripts/build-postfx.js dof",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js",
    "dev": "vite --config vite.config.js --open /examples/index.html",
    "build:demo": "vite build --config vite.config.js"
  }
}
