{
  "name": "@margoengine/dof",
  "version": "1.0.0",
  "description": "Optional two-pass WebGPU depth of field with circular bokeh.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "dof"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/dof"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lens": {
      "types": "./dist/lens.d.ts",
      "import": "./dist/lens.js"
    },
    "./autofocus": {
      "types": "./dist/autofocus.d.ts",
      "import": "./dist/autofocus.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-postfx.js dof",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js",
    "dev": "vite --config vite.config.js --open /examples/index.html",
    "build:demo": "vite build --config vite.config.js",
    "test:gpu": "cd ../.. && node packages/dof/tests/gpu/lens-check.mjs && node packages/dof/tests/gpu/compat-check.mjs"
  }
}
