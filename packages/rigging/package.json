{
  "name": "@margoengine/rigging",
  "version": "1.0.0",
  "description": "Rigging and animation authoring: automatic skin weights, weight painting, skin checks, IK chains with poles, retarget presets, spring bones, VRM 1.0 avatars, geodesic voxel weights, corrective shapes, weight transfer.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "rigging",
    "skinning",
    "weights",
    "vrm",
    "voxel-weights",
    "correctives"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/rigging"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ik": {
      "types": "./dist/ik.d.ts",
      "import": "./dist/ik.js"
    },
    "./retarget": {
      "types": "./dist/retarget.d.ts",
      "import": "./dist/retarget.js"
    },
    "./hulls": {
      "types": "./dist/hulls.d.ts",
      "import": "./dist/hulls.js"
    },
    "./springs": {
      "types": "./dist/springs.d.ts",
      "import": "./dist/springs.js"
    },
    "./vrm": {
      "types": "./dist/vrm.d.ts",
      "import": "./dist/vrm.js"
    },
    "./voxel-weights": {
      "types": "./dist/voxel-weights.d.ts",
      "import": "./dist/voxel-weights.js"
    },
    "./correctives": {
      "types": "./dist/correctives.d.ts",
      "import": "./dist/correctives.js"
    },
    "./transfer": {
      "types": "./dist/transfer.d.ts",
      "import": "./dist/transfer.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/animator": "^1.0.0",
    "@margoengine/core": "^1.0.0",
    "@margoengine/kinematics-constraints": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animator": {
      "optional": true
    },
    "@margoengine/core": {
      "optional": true
    },
    "@margoengine/kinematics-constraints": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js rigging",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/rigging-browser.mjs",
    "prepack": "npm run build"
  }
}
