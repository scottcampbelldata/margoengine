{
  "name": "@margoengine/audio",
  "version": "1.0.0",
  "description": "Web Audio listener, global and positional sounds and a frequency analyser for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "audio"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/audio"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js audio",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./occlusion": {
      "types": "./dist/occlusion.d.ts",
      "import": "./dist/occlusion.js"
    },
    "./doppler": {
      "types": "./dist/doppler.d.ts",
      "import": "./dist/doppler.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./music": {
      "types": "./dist/music.d.ts",
      "import": "./dist/music.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.js"
    },
    "./ambisonics": {
      "types": "./dist/ambisonics.d.ts",
      "import": "./dist/ambisonics.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/mixer": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/bvh": {
      "optional": true
    },
    "@margoengine/mixer": {
      "optional": true
    }
  }
}
