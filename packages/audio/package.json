    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/audio"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/audio.test.js tests/pause.test.js",
