{
  "name": "@margoengine/tiles",
  "version": "1.0.0",
  "description": "Streaming OGC 3D Tiles 1.1: implicit and explicit tilesets, screen-space-error selection, a fetch queue, a memory budget and glTF tiles drawn through gltf-pro.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "3d-tiles",
    "ogc",
    "gis",
    "digital-twin",
    "streaming"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/tiles"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./properties": {
      "types": "./dist/properties.d.ts",
      "import": "./dist/properties.js"
    },
    "./imagery": {
      "types": "./dist/imagery.d.ts",
      "import": "./dist/imagery.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./i3dm": {
      "types": "./dist/i3dm.d.ts",
      "import": "./dist/i3dm.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./splats": {
      "types": "./dist/splats.d.ts",
      "import": "./dist/splats.js"
    },
    "./s2": {
      "types": "./dist/s2.d.ts",
      "import": "./dist/s2.js"
    },
    "./terrain": {
      "types": "./dist/terrain.d.ts",
      "import": "./dist/terrain.js"
    },
    "./ion": {
      "types": "./dist/ion.d.ts",
      "import": "./dist/ion.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/points": "^1.0.0",
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/splats": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/points": {
      "optional": true
    },
    "@margoengine/decoders": {
      "optional": true
    },
    "@margoengine/splats": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js tiles",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/tiles-browser.mjs",
    "prepack": "npm run build"
  }
}
