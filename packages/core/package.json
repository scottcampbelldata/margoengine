{
  "name": "@margoengine/core",
  "version": "1.0.0",
  "description": "WebGPU rendering and a Wasm transform kernel. WebGL2 is the optional @margoengine/webgl package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test ../../tests/modern.test.js ../../tests/deep-core*.test.js ../../tests/deep-ingestion-cad-initialization.test.js ../../tests/modern-frame-timing.test.js ../../tests/modern-msaa.test.js ../../tests/modern-quaternion.test.js ../../tests/modern-resolution.test.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://margoengine.com"
}
