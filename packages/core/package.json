{
  "name": "@margoengine/core",
  "version": "1.0.0",
  "description": "WebGPU rendering and a Wasm transform kernel. WebGL2 is the optional @margoengine/webgl2-compat package.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "wasm",
    "rust",
    "renderer"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js ../../tests/modern.test.js ../../tests/deep-core*.test.js ../../tests/modern-frame-timing.test.js ../../tests/modern-msaa.test.js ../../tests/modern-quaternion.test.js ../../tests/modern-resolution.test.js",
    "test:gpu": "node tests/empty.browser.mjs && node tests/scale.browser.mjs",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
