{
  "name": "@margoengine/navmesh",
  "version": "1.0.0",
  "description": "Convex polygon navigation with A*, funnel paths and ORCA avoidance; navmesh generation from triangles (./build) tiled meshes that rebuild at run time (./tiles), baked files (./codec), jump links (./links), long routes (./hierarchy), debug draw (./debug), voxel worlds (./voxel) and flying agents (./volume).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "navmesh"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/navmesh"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "import": "./dist/links.js"
    },
    "./hierarchy": {
      "types": "./dist/hierarchy.d.ts",
      "import": "./dist/hierarchy.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js"
    },
    "./voxel": {
      "types": "./dist/voxel.d.ts",
      "import": "./dist/voxel.js"
    },
    "./volume": {
      "types": "./dist/volume.d.ts",
      "import": "./dist/volume.js"
    },
    "./tiles": {
      "types": "./dist/tiles.d.ts",
      "import": "./dist/tiles.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./queries": {
      "types": "./dist/queries.d.ts",
      "import": "./dist/queries.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/lines": "^1.0.0",
    "@margoengine/voxel": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/lines": {
      "optional": true
    },
    "@margoengine/voxel": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js navmesh",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
