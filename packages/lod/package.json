{
  "name": "@margoengine/lod",
  "version": "1.0.0",
  "description": "Level of detail with hysteresis and screen-size switching for thousands of instances, plus GPU-baked octahedral imposters drawn in one instanced call per atlas.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "lod"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/lod"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./clusters": {
      "types": "./dist/clusters.d.ts",
      "import": "./dist/clusters.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./fade": {
      "types": "./dist/fade.d.ts",
      "import": "./dist/fade.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/animation": "^1.0.0",
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/mesh-edit": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animation": {
      "optional": true
    },
    "@margoengine/materials": {
      "optional": true
    },
    "@margoengine/mesh-edit": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js lod",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/lod/test/browser-check.mjs && node packages/lod/test/imposter-check.mjs && node packages/lod/test/auto-check.mjs && node packages/lod/test/rig-check.mjs && node packages/lod/test/fade-check.mjs && node packages/lod/test/imposter-full-check.mjs && node packages/lod/test/stream-check.mjs && node packages/lod/test/imposter-outline-check.mjs && node packages/lod/test/clusters-check.mjs"
  }
}
