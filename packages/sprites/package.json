{
  "name": "@margoengine/sprites",
  "version": "1.0.0",
  "description": "2D sprites at exact pixels: one instanced draw per layer, atlas rectangles, pivot, flip, rotation, tint, z and y sorting, integer pixel snapping and an optional normal map target, camera-facing billboards in 3D and bone-driven 2D skeletal meshes.",
  "keywords": [
    "margoengine",
    "webgpu",
    "2d",
    "sprites",
    "pixel-art"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/sprites"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./aseprite": {
      "types": "./dist/aseprite.d.ts",
      "import": "./dist/aseprite.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./billboard": {
      "types": "./dist/billboard.d.ts",
      "import": "./dist/billboard.js"
    },
    "./shader": {
      "types": "./dist/shader.d.ts",
      "import": "./dist/shader.js"
    },
    "./skeletal": {
      "types": "./dist/skeletal.d.ts",
      "import": "./dist/skeletal.js"
    },
    "./slice": {
      "types": "./dist/slice.d.ts",
      "import": "./dist/slice.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./blend": {
      "types": "./dist/blend.d.ts",
      "import": "./dist/blend.js"
    },
    "./spine": {
      "types": "./dist/spine.d.ts",
      "import": "./dist/spine.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js sprites",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu": "cd ../.. && node packages/sprites/tests/browser-check.mjs",
    "prepack": "npm run build",
    "test:gpu:billboard": "cd ../.. && node packages/sprites/tests/billboard-check.mjs",
    "test:gpu:smooth": "cd ../.. && node packages/sprites/tests/smooth-check.mjs",
    "test:gpu:shader": "cd ../.. && node packages/sprites/tests/shader-check.mjs",
    "test:gpu:pages": "cd ../.. && node packages/sprites/tests/pages-check.mjs",
    "test:gpu:skeletal": "cd ../.. && node packages/sprites/tests/skeletal-check.mjs",
    "test:gpu:masks": "cd ../.. && node packages/sprites/tests/masks-check.mjs",
    "test:gpu:slice": "cd ../.. && node packages/sprites/tests/slice-check.mjs",
    "test:gpu:rigging": "cd ../.. && node packages/sprites/tests/rigging-check.mjs",
    "test:gpu:pick": "cd ../.. && node packages/sprites/tests/pick-check.mjs",
    "test:gpu:blend": "cd ../.. && node packages/sprites/tests/blend-check.mjs",
    "test:gpu:spine": "cd ../.. && node packages/sprites/tests/spine-check.mjs"
  }
}
