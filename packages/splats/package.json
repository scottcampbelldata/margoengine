{
  "name": "@margoengine/splats",
  "version": "1.0.0",
  "description": "Optional Gaussian splats with GPU covariance projection and stable compute radix sorting.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "gaussian-splatting"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/splats"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:gpu": "cd ../.. && node packages/splats/test/gpu/check.mjs",
    "test": "node --test test/*.test.js ../../tests/modern-temporal.test.js ../../tests/modern-data-subpaths.test.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./depth": {
      "types": "./dist/depth.d.ts",
      "import": "./dist/depth.js"
    },
    "./lod": {
      "types": "./dist/lod.d.ts",
      "import": "./dist/lod.js"
    },
    "./lighting": {
      "types": "./dist/lighting.d.ts",
      "import": "./dist/lighting.js"
    },
    "./set": {
      "types": "./dist/set.d.ts",
      "import": "./dist/set.js"
    },
    "./edit": {
      "types": "./dist/brush.d.ts",
      "import": "./dist/brush.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./animate": {
      "types": "./dist/animate.d.ts",
      "import": "./dist/animate.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/decoders": "^1.0.0"
  }
}
