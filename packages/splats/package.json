{
  "name": "@margoengine/splats",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Optional Gaussian splats with GPU covariance projection and stable compute radix sorting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/splats"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test ../../tests/modern-temporal.test.js ../../tests/modern-data-subpaths.test.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
