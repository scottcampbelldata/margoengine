{
  "name": "@margoengine/wfc",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Seeded wave function collapse: 3D tile adjacency and the 2D overlapping (sample-based) model with backtracking.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlapping": {
      "types": "./dist/overlapping.d.ts",
      "import": "./dist/overlapping.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js wfc",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "homepage": "https://margoengine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/wfc"
  }
}
