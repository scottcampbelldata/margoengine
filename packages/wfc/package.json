{
  "name": "@margoengine/wfc",
  "version": "1.0.0",
  "description": "Seeded wave function collapse: 3D tile adjacency and the 2D overlapping (sample-based) model with backtracking.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "wfc"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/wfc"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlapping": {
      "types": "./dist/overlapping.d.ts",
      "import": "./dist/overlapping.js"
    },
    "./constraints": {
      "types": "./dist/constraints.d.ts",
      "import": "./dist/constraints.js"
    },
    "./sockets": {
      "types": "./dist/sockets.d.ts",
      "import": "./dist/sockets.js"
    },
    "./chunks": {
      "types": "./dist/chunks.d.ts",
      "import": "./dist/chunks.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./assemble": {
      "types": "./dist/assemble.d.ts",
      "import": "./dist/assemble.js"
    },
    "./tileset": {
      "types": "./dist/tileset.d.ts",
      "import": "./dist/tileset.js"
    },
    "./overlapping3d": {
      "types": "./dist/overlapping3d.d.ts",
      "import": "./dist/overlapping3d.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js wfc && node scripts/copy-wasm.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "node test/browser-check.mjs && node test/assemble-browser.mjs"
  }
}
