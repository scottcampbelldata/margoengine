{
  "name": "@margoengine/labels",
  "version": "1.0.0",
  "description": "HTML labels and CSS 3D objects positioned over a Margo Engine canvas.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "labels"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/labels"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./declutter": {
      "types": "./dist/declutter.d.ts",
      "import": "./dist/declutter.js"
    },
    "./callouts": {
      "types": "./dist/callouts.d.ts",
      "import": "./dist/callouts.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./distance": {
      "types": "./dist/distance.d.ts",
      "import": "./dist/distance.js"
    },
    "./cluster": {
      "types": "./dist/cluster.d.ts",
      "import": "./dist/cluster.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/text": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
