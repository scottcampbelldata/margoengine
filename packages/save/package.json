{
  "name": "@margoengine/save",
  "version": "1.0.0",
  "description": "Save and load: versioned scene and world documents with stable ids, prefabs with overrides, migrations, all-or-nothing loading and storage adapters.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "save",
    "load",
    "serialization",
    "prefab",
    "indexeddb",
    "localstorage"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/save"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./safe": {
      "types": "./dist/safe.d.ts",
      "import": "./dist/safe.js"
    },
    "./opfs": {
      "types": "./dist/opfs.d.ts",
      "import": "./dist/opfs.js"
    },
    "./signed": {
      "types": "./dist/signed.d.ts",
      "import": "./dist/signed.js"
    },
    "./scene-state": {
      "types": "./dist/scene-state.d.ts",
      "import": "./dist/scene-state.js"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/animation": "^1.0.0",
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/shader": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animation": {
      "optional": true
    },
    "@margoengine/core": {
      "optional": true
    },
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/materials": {
      "optional": true
    },
    "@margoengine/shader": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/ecs": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js save",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/save/tests/browser/engine-check.mjs && node packages/save/tests/browser/slots-check.mjs && node packages/save/tests/browser/safe-check.mjs && node packages/save/tests/browser/remote-check.mjs",
    "test:gpu:materials": "cd ../.. && node packages/save/tests/browser/materials-check.mjs"
  }
}
