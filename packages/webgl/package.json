{
  "name": "@margoengine/webgl",
  "version": "1.0.0",
  "description": "WebGL2 fallback renderer for browsers without WebGPU: flat-shaded PBR core meshes, opt in with Engine.create(canvas, {fallback: webglRenderer}).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "webgl",
    "webgl2",
    "fallback"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/webgl"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./restore": {
      "types": "./dist/restore.d.ts",
      "import": "./dist/restore.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/webgl2-compat": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js webgl",
    "test": "npm run build && node --test test/*.test.js",
    "test:gpu": "npm run build && cd ../.. && node packages/webgl/test/browser-check.mjs",
    "prepack": "npm run build"
  }
}
