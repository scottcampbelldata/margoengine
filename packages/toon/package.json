{
  "name": "@margoengine/toon",
  "version": "1.0.0",
  "description": "Stepped diffuse shading and inverted-hull outlines.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "toon"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/toon"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./screen-outline": {
      "types": "./dist/screen-outline.d.ts",
      "import": "./dist/screen-outline.js"
    },
    "./hatch-models": {
      "types": "./dist/hatch-models.d.ts",
      "import": "./dist/hatch-models.js"
    },
    "./hatch": {
      "types": "./dist/hatch.d.ts",
      "import": "./dist/hatch.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/creative": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf-pro": { "optional": true }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js toon",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/toon/test/models-check.mjs && node packages/toon/test/hatch-check.mjs && node packages/toon/test/screen-outline.browser.mjs && node packages/toon/test/hatch-models.browser.mjs"
  }
}
