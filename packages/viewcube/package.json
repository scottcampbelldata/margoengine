{
  "name": "@margoengine/viewcube",
  "version": "1.0.0",
  "description": "CAD view cube: shows the camera orientation and animates to top, front, side and isometric views, with a perspective/orthographic toggle.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "viewcube"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/viewcube"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./axes": {
      "types": "./dist/axes.d.ts",
      "import": "./dist/axes.js"
    },
    "./up": {
      "types": "./dist/up.d.ts",
      "import": "./dist/up.js"
    },
    "./fit": {
      "types": "./dist/fit.d.ts",
      "import": "./dist/fit.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js viewcube",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:browser": "cd ../.. && node packages/viewcube/test/browser-check.mjs"
  }
}
