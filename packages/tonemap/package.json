{
  "name": "@margoengine/tonemap",
  "version": "1.0.0",
  "description": "Optional color grading: Khronos PBR Neutral (the engine default), AgX and ACES fitted curves, 2-65 cube LUTs.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "tonemap"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/tonemap"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-postfx.js tonemap",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js",
    "dev": "vite --config vite.config.js --open /examples/index.html",
    "build:demo": "vite build --config vite.config.js",
    "test:gpu:lut-sizes": "cd ../.. && node scripts/tonemap-lut-sizes-gpu-check.js"
  }
}
