{
  "name": "@margoengine/exporters",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "glTF/GLB, STL, OBJ, PLY, USDZ and COLLADA exporters for Margo Engine scenes and geometry data.",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/exporters.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./usdz": {
      "types": "./dist/usdz.d.ts",
      "import": "./dist/usdz.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./dae": {
      "types": "./dist/dae.d.ts",
      "import": "./dist/dae.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./skin": {
      "types": "./dist/skin.d.ts",
      "import": "./dist/skin.js"
    },
    "./godot": {
      "types": "./dist/godot.d.ts",
      "import": "./dist/godot.js"
    },
    "./unity": {
      "types": "./dist/unity.d.ts",
      "import": "./dist/unity.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf-pro": {
      "optional": true
    }
  },
  "homepage": "https://margoengine.com",
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
