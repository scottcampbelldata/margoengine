{
  "name": "@margoengine/exporters",
  "version": "1.0.0",
  "description": "glTF/GLB, STL, OBJ, PLY, USDZ and COLLADA exporters for Margo Engine scenes and geometry data.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "exporters"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/exporters"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/exporters.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build",
    "test:png:browser": "cd ../.. && node packages/exporters/tests/png-browser.mjs",
    "test:capture:browser": "cd ../.. && node packages/exporters/tests/capture-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./usdz": {
      "types": "./dist/usdz.d.ts",
      "import": "./dist/usdz.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./dae": {
      "types": "./dist/dae.d.ts",
      "import": "./dist/dae.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./roblox": {
      "types": "./dist/roblox.d.ts",
      "import": "./dist/roblox.js"
    },
    "./roblox-chunks": {
      "types": "./dist/roblox-chunks.d.ts",
      "import": "./dist/roblox-chunks.js"
    },
    "./skin": {
      "types": "./dist/skin.d.ts",
      "import": "./dist/skin.js"
    },
    "./godot": {
      "types": "./dist/godot.d.ts",
      "import": "./dist/godot.js"
    },
    "./godot-addon": {
      "types": "./dist/godot-addon.d.ts",
      "import": "./dist/godot-addon.js"
    },
    "./unity": {
      "types": "./dist/unity.d.ts",
      "import": "./dist/unity.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js"
    },
    "./import-names": {
      "types": "./dist/import-names.d.ts",
      "import": "./dist/import-names.js"
    },
    "./godot-lightmap": {
      "types": "./dist/godot-lightmap.d.ts",
      "import": "./dist/godot-lightmap.js"
    },
    "./unity-precision": {
      "types": "./dist/unity-precision.d.ts",
      "import": "./dist/unity-precision.js"
    },
    "./unity-precision-importer": {
      "types": "./dist/unity-precision-importer.d.ts",
      "import": "./dist/unity-precision-importer.js"
    },
    "./unity-pixel-art": {
      "types": "./dist/unity-pixel-art.d.ts",
      "import": "./dist/unity-pixel-art.js"
    },
    "./unreal-precision": {
      "types": "./dist/unreal-precision.d.ts",
      "import": "./dist/unreal-precision.js"
    },
    "./unreal-precision-importer": {
      "types": "./dist/unreal-precision-importer.d.ts",
      "import": "./dist/unreal-precision-importer.js"
    },
    "./unreal-pixel-art": {
      "types": "./dist/unreal-pixel-art.d.ts",
      "import": "./dist/unreal-pixel-art.js"
    },
    "./godot-precision-addon": {
      "types": "./dist/godot-precision-addon.d.ts",
      "import": "./dist/godot-precision-addon.js"
    },
    "./godot-precision": {
      "types": "./dist/godot-precision.d.ts",
      "import": "./dist/godot-precision.js"
    },
    "./godot-flipbook": {
      "types": "./dist/godot-flipbook.d.ts",
      "import": "./dist/godot-flipbook.js"
    },
    "./roblox-runtime": {
      "types": "./dist/roblox-runtime.d.ts",
      "import": "./dist/roblox-runtime.js"
    },
    "./roblox-runtime-restore": {
      "types": "./dist/roblox-runtime-restore.d.ts",
      "import": "./dist/roblox-runtime-restore.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/decoders": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/decoders": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
