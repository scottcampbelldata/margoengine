{
  "name": "@margoengine/exporters",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "glTF/GLB, STL, OBJ and PLY exporters for Margo Engine scenes and geometry data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/exporters"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/exporters.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./usdz": {
      "types": "./dist/usdz.d.ts",
      "import": "./dist/usdz.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^0.1.0 || ^1.0.0"
  },
  "homepage": "https://margoengine.com",
  "dependencies": {
    "@margoengine/math": "0.1.0"
  }
}
