{
  "name": "@margoengine/voxel-pathtracer",
  "version": "1.0.0",
  "description": "Progressive WebGPU path tracer for instanced voxel models: diffuse, plastic, metal, glass, emissive, blended and volumetric materials, sun, sky, HDR environment and area lights, depth of field, motion blur, a denoiser and PNG capture.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel",
    "pathtracer"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel-pathtracer"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./restir": {
      "types": "./dist/restir.d.ts",
      "import": "./dist/restir.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    },
    "./guiding": {
      "types": "./dist/guiding.d.ts",
      "import": "./dist/guiding.js"
    },
    "./sky": {
      "types": "./dist/sky-environment.d.ts",
      "import": "./dist/sky-environment.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./spectral": {
      "types": "./dist/spectral.d.ts",
      "import": "./dist/spectral.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/sky": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel-pathtracer",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu:restir": "cd ../.. && node packages/voxel-pathtracer/tests/restir-browser.mjs",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs --report=base agx groundprecision denoiseholdout compat compile preview traversal glassfurnace analytic glasslight sky projections arealight dispersion microfacet energy environment textures cutout shapes transparent determinism convergence",
    "test:gpu:denoise": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs --report=denoise denoise-diffuse denoise-opaque denoisepeak denoisehistory",
    "test:gpu:denoise-materials": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs --report=denoise-materials denoise-materials",
    "test:gpu:denoise-caustics": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs --report=denoise-caustics denoise-caustics",
    "test:gpu:viewport": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs --report=viewport motion lens viewport bloom capture materialtables largemodels native4k",
    "test:gpu:slow-compile": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs agx --pipeline-delay=500",
    "test:gpu:spec-math": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs projections --spec-math-error=1",
    "test:gpu:stall": "cd ../.. && node packages/voxel-pathtracer/tests/stall-check.mjs",
    "test:gpu:guiding": "cd ../.. && node packages/voxel-pathtracer/tests/guiding-browser.mjs",
    "test:gpu:sky": "cd ../.. && node packages/voxel-pathtracer/tests/sky-browser.mjs",
    "test:gpu:media": "cd ../.. && node packages/voxel-pathtracer/tests/media-browser.mjs",
    "build:mesh": "node scripts/build-mesh.mjs",
    "test:mesh-kernel": "node scripts/build-mesh.mjs --test",
    "test:gpu:mesh": "cd ../.. && node packages/voxel-pathtracer/tests/mesh-browser.mjs",
    "test:gpu:spectral": "cd ../.. && node packages/voxel-pathtracer/tests/spectral-browser.mjs",
    "test:gpu:parity-gamma": "cd ../.. && node packages/voxel-pathtracer/tests/magicavoxel-gamma-browser.mjs",
    "test:gpu:history-taps": "cd ../.. && node packages/voxel-pathtracer/tests/history-taps-browser.mjs"
  },
  "margo": {
    "gpuTestTimeoutMinutes": {
      "test:gpu": 10,
      "test:gpu:restir": 10,
      "test:gpu:denoise": 10,
      "test:gpu:denoise-materials": 15,
      "test:gpu:denoise-caustics": 15,
      "test:gpu:viewport": 10,
      "test:gpu:guiding": 10,
      "test:gpu:sky": 10,
      "test:gpu:media": 10,
      "test:gpu:mesh": 10,
      "test:gpu:spectral": 10,
      "test:gpu:parity-gamma": 6,
      "test:gpu:history-taps": 6
    }
  },
  "peerDependenciesMeta": {
    "@margoengine/sky": {
      "optional": true
    }
  }
}
