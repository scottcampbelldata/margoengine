{
  "name": "@margoengine/voxel-pathtracer",
  "version": "1.0.0",
  "description": "Progressive WebGPU path tracer for instanced voxel models: diffuse, plastic, metal, glass, emissive, blended and volumetric materials, sun, sky, HDR environment and area lights, depth of field, motion blur, a denoiser and PNG capture.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel",
    "pathtracer"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel-pathtracer"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel-pathtracer",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs",
    "test:gpu:slow-compile": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs agx --pipeline-delay=500",
    "test:gpu:spec-math": "cd ../.. && node packages/voxel-pathtracer/tests/browser-check.mjs projections --spec-math-error=1"
  },
  "margo": {
    "gpuTestSteps": {
      "test:gpu": [
        "agx groundprecision denoiseholdout compat compile",
        "preview traversal analytic glasslight sky",
        "projections arealight dispersion microfacet energy",
        "environment textures cutout shapes transparent",
        "determinism convergence denoise denoisepeak denoisehistory",
        "motion lens viewport bloom capture materialtables",
        "largemodels",
        "native4k"
      ]
    }
  }
}
