{
  "name": "@margoengine/materials",
  "version": "1.0.0",
  "description": "Optional glTF PBR material lobes, transmission, volume, parallax occlusion, triplanar and subsurface scattering, and typed node graphs through an isolated extension slot.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "materials"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/materials"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js materials",
    "test": "npm run build && node --test tests/*.test.js test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/materials/test/browser-check.mjs",
    "test:gpu:cutout-casters": "cd ../.. && node packages/shadows/test/cutout-casters-browser.mjs",
    "test:gpu:cutout-passes": "cd ../.. && node packages/materials/test/cutout-passes-browser.mjs",
    "test:gpu:vertex-inputs": "cd ../.. && node packages/materials/test/vertex-inputs-browser.mjs",
    "test:gpu:features": "cd ../.. && node packages/materials/test/features-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./transmission": {
      "types": "./dist/transmission.d.ts",
      "import": "./dist/transmission.js"
    },
    "./batched": {
      "types": "./dist/batched.d.ts",
      "import": "./dist/batched.js"
    },
    "./alpha-hash": {
      "types": "./dist/alpha-hash.d.ts",
      "import": "./dist/alpha-hash.js"
    },
    "./object-normal": {
      "types": "./dist/object-normal.d.ts",
      "import": "./dist/object-normal.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  }
}
