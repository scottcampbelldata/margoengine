{
  "name": "@margoengine/materials",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "description": "Optional glTF PBR material lobes, transmission, volume and typed node graphs through an isolated extension slot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/materials"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js materials",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@margoengine/core": "0.1.0",
    "@margoengine/gltf-pro": "0.1.0"
  },
  "homepage": "https://margoengine.com"
}
