{
  "name": "@margoengine/materials",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Optional glTF PBR material lobes, transmission, volume and typed node graphs through an isolated extension slot.",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js materials",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./transmission": {
      "types": "./dist/transmission.d.ts",
      "import": "./dist/transmission.js"
    },
    "./batched": {
      "types": "./dist/batched.d.ts",
      "import": "./dist/batched.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "homepage": "https://margoengine.com"
}
