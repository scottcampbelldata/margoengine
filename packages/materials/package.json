{
  "name": "@margoengine/materials",
  "version": "1.0.0",
  "description": "Optional glTF PBR material lobes, transmission, volume, parallax occlusion, triplanar and subsurface scattering, and typed node graphs through an isolated extension slot.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "materials"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/materials"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js materials",
    "test": "npm run build && node --test tests/*.test.js test/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/materials/test/browser-check.mjs && node packages/materials/test/hair-cards-browser.mjs && node packages/materials/test/borrowed-restore-browser.mjs && node packages/materials/test/dual-source-browser.mjs",
    "test:gpu:cutout-casters": "cd ../.. && node packages/shadows/test/cutout-casters-browser.mjs",
    "test:gpu:cutout-passes": "cd ../.. && node packages/materials/test/cutout-passes-browser.mjs",
    "test:gpu:vertex-inputs": "cd ../.. && node packages/materials/test/vertex-inputs-browser.mjs",
    "test:gpu:features": "cd ../.. && node packages/materials/test/features-browser.mjs",
    "test:gpu:more": "cd ../.. && node scripts/mat-more-gpu-check.js",
    "test:gpu:back-side": "cd ../.. && node scripts/material-back-side-gpu-check.js",
    "test:gpu:depth-distance": "cd ../.. && node scripts/material-depth-distance-gpu-check.js",
    "test:gpu:dispersion": "cd ../.. && node scripts/material-dispersion-gpu-check.js",
    "test:gpu:render-state": "cd ../.. && node scripts/material-render-state-gpu-check.js",
    "test:gpu:wireframe": "cd ../.. && node scripts/material-wireframe-gpu-check.js",
    "test:gpu:uv-groups": "cd ../.. && node scripts/materials-uv-groups-gpu-check.js",
    "test:gpu:normal-map": "cd ../.. && node scripts/normal-map-orientation-gpu-check.js",
    "test:gpu:physical-maps": "cd ../.. && node scripts/physical-material-maps-gpu-check.js",
    "test:gpu:sheen-albedo": "cd ../.. && node scripts/sheen-albedo-gpu-check.js",
    "test:gpu:transmission-layers": "cd ../.. && node packages/materials/test/transmission-background-browser.mjs",
    "test:gpu:fur": "cd ../.. && node packages/materials/test/fur-browser.mjs",
    "test:gpu:plugins": "cd ../.. && node packages/materials/test/plugins-browser.mjs",
    "test:gpu:native-glass": "cd ../.. && node packages/materials/test/native-glass-browser.mjs && node packages/materials/test/native-glass-browser.mjs --compat",
    "test:gpu:portal": "cd ../.. && node packages/materials/test/portal-browser.mjs",
    "test:gpu:batched-lod": "cd ../.. && node packages/materials/test/batched-lod-browser.mjs && node packages/materials/test/batched-lod-browser.mjs --compat",
    "test:gpu:instance-attributes": "cd ../.. && node packages/materials/test/instance-attributes-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./transmission": {
      "types": "./dist/transmission.d.ts",
      "import": "./dist/transmission.js"
    },
    "./batched": {
      "types": "./dist/batched.d.ts",
      "import": "./dist/batched.js"
    },
    "./batched-lod": {
      "types": "./dist/batched-lod.d.ts",
      "import": "./dist/batched-lod.js"
    },
    "./mips": {
      "types": "./dist/mips.d.ts",
      "import": "./dist/mips.js"
    },
    "./prefilter": {
      "types": "./dist/prefilter.d.ts",
      "import": "./dist/prefilter.js"
    },
    "./layered": {
      "types": "./dist/layered.d.ts",
      "import": "./dist/layered.js"
    },
    "./alpha-hash": {
      "types": "./dist/alpha-hash.d.ts",
      "import": "./dist/alpha-hash.js"
    },
    "./object-normal": {
      "types": "./dist/object-normal.d.ts",
      "import": "./dist/object-normal.js"
    },
    "./hair": {
      "types": "./dist/hair.d.ts",
      "import": "./dist/hair.js"
    },
    "./eye": {
      "types": "./dist/eye.d.ts",
      "import": "./dist/eye.js"
    },
    "./skin": {
      "types": "./dist/skin.d.ts",
      "import": "./dist/skin.js"
    },
    "./stochastic": {
      "types": "./dist/stochastic.d.ts",
      "import": "./dist/stochastic.js"
    },
    "./serialization": {
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./transmission-layers": {
      "types": "./dist/transmission-layers.d.ts",
      "import": "./dist/transmission-layers.js"
    },
    "./fur": {
      "types": "./dist/fur.d.ts",
      "import": "./dist/fur.js"
    },
    "./fake-shadows": {
      "types": "./dist/fake-shadows.d.ts",
      "import": "./dist/fake-shadows.js"
    },
    "./retroreflection": {
      "types": "./dist/retroreflection.d.ts",
      "import": "./dist/retroreflection.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./instance-attributes": {
      "types": "./dist/instance-attributes.d.ts",
      "import": "./dist/instance-attributes.js"
    },
    "./soot": {
      "types": "./dist/soot.d.ts",
      "import": "./dist/soot.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./portal": {
      "types": "./dist/portal.d.ts",
      "import": "./dist/portal.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/gltf": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/environment": {
      "optional": true
    }
  }
}
