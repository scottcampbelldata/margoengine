{
  "name": "@margoengine/post",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "HDR bloom, AgX tonemapping, frame-graph SSAO, FXAA and a shared-capture effect stack for Margo Engine WebGPU.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/post"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bloom": {
      "types": "./dist/bloom.d.ts",
      "import": "./dist/bloom.js"
    },
    "./ssao": {
      "types": "./dist/ssao.d.ts",
      "import": "./dist/ssao.js"
    },
    "./scene-fade": {
      "types": "./dist/scene-fade.d.ts",
      "import": "./dist/scene-fade.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./fxaa": {
      "types": "./dist/fxaa.d.ts",
      "import": "./dist/fxaa.js"
    }
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "peerDependencies": {
    "@margoengine/core": "0.1.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "0.1.0"
  }
}
