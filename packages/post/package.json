    "test:gpu": "cd ../.. && node packages/post/test/image-browser.mjs && node packages/post/test/outline-browser.mjs && node packages/post/test/contact-shadows-browser.mjs && node packages/post/test/sss-browser.mjs && node packages/post/test/material-decals-browser.mjs && node packages/post/test/decals-cull-browser.mjs && node packages/post/test/ssr-rough-browser.mjs && node packages/post/test/ssgi-bounce-browser.mjs && node packages/post/test/anamorphic-browser.mjs && node packages/post/test/blur-browser.mjs && node packages/post/test/radial-blur-browser.mjs && node packages/post/test/lens-browser.mjs && node packages/post/test/selective-bloom-browser.mjs && node packages/post/test/mask-browser.mjs && node packages/post/test/pixelate-browser.mjs && node packages/post/test/halftone-browser.mjs && node packages/post/test/ascii-browser.mjs && node packages/post/test/overlays-browser.mjs && node packages/post/test/stylize-browser.mjs && node packages/post/test/curvature-browser.mjs && node packages/post/test/bloom-finite-browser.mjs && node packages/post/test/bloom-energy-browser.mjs && node packages/post/test/fxaa-gate-browser.mjs && node packages/post/test/stack-dynamic-browser.mjs && node packages/post/test/borrowed-restore-browser.mjs && node packages/post/test/scene-targets-shadow-browser.mjs && node packages/post/test/gtao-sky-browser.mjs && node packages/post/test/heat-haze-browser.mjs && node packages/post/test/replay-bindings-browser.mjs && node packages/post/test/alpha-rim-browser.mjs && node packages/post/test/ssao-silhouette-browser.mjs",
    "test:gpu:looks": "cd ../.. && node scripts/post-looks-gpu-check.js",
    "test:gpu:ssao-resolve": "cd ../.. && node packages/post/test/ssao-resolve-browser.mjs",
    "test:gpu:ssao": "cd ../.. && node scripts/ssao-gpu-check.js",
    "test:gpu:flare": "cd ../.. && node examples/package-benchmarks/post-effects-gpu.mjs --only=flare",
    "test:settings:browser": "cd ../.. && node packages/post/test/settings-browser.mjs && node packages/post/test/settings-browser.mjs --compat"
  },
