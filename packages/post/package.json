{
  "name": "@margoengine/post",
  "version": "1.0.0",
  "description": "HDR bloom, frame-graph SSAO, GTAO, SSGI and SSR, motion blur, lens flare, SMAA and FXAA, glitch and afterimage, and post-effect stacks for Margo Engine WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "post-processing",
    "ssao",
    "bloom"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/post"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js ../../tests/modern-scene-fade-lifecycle.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "cd ../.. && node packages/post/test/image-browser.mjs && node packages/post/test/outline-browser.mjs && node packages/post/test/contact-shadows-browser.mjs && node packages/post/test/sss-browser.mjs && node packages/post/test/material-decals-browser.mjs && node packages/post/test/decals-cull-browser.mjs",
    "test:gpu:looks": "cd ../.. && node scripts/post-looks-gpu-check.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bloom": {
      "types": "./dist/bloom.d.ts",
      "import": "./dist/bloom.js"
    },
    "./ssao": {
      "types": "./dist/ssao.d.ts",
      "import": "./dist/ssao.js"
    },
    "./scene-fade": {
      "types": "./dist/scene-fade.d.ts",
      "import": "./dist/scene-fade.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./fxaa": {
      "types": "./dist/fxaa.d.ts",
      "import": "./dist/fxaa.js"
    },
    "./decals": {
      "types": "./dist/decals.d.ts",
      "import": "./dist/decals.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js"
    },
    "./gtao": {
      "types": "./dist/gtao.d.ts",
      "import": "./dist/gtao.js"
    },
    "./ssgi": {
      "types": "./dist/ssgi.d.ts",
      "import": "./dist/ssgi.js"
    },
    "./motion-blur": {
      "types": "./dist/motion-blur.d.ts",
      "import": "./dist/motion-blur.js"
    },
    "./lens-flare": {
      "types": "./dist/lens-flare.d.ts",
      "import": "./dist/lens-flare.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./smaa": {
      "types": "./dist/smaa.d.ts",
      "import": "./dist/smaa.js"
    },
    "./glitch": {
      "types": "./dist/glitch.d.ts",
      "import": "./dist/glitch.js"
    },
    "./afterimage": {
