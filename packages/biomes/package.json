{
  "name": "@margoengine/biomes",
  "version": "1.0.0",
  "description": "Biome maps from a heightmap and a few climate settings: integer fixed-point climate fields, biome classification with smooth ecotones, presets, terrain ground weights and editor hooks, byte-identical on every platform.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "biomes",
    "terrain",
    "climate",
    "procedural",
    "deterministic"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/biomes"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toolkit": {
      "types": "./dist/toolkit.d.ts",
      "import": "./dist/toolkit.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "import": "./dist/region.js"
    },
    "./hydrology": {
      "types": "./dist/hydrology.d.ts",
      "import": "./dist/hydrology.js"
    },
    "./disturbance": {
      "types": "./dist/disturbance.d.ts",
      "import": "./dist/disturbance.js"
    },
    "./seasons": {
      "types": "./dist/seasons.d.ts",
      "import": "./dist/seasons.js"
    },
    "./erosion": {
      "types": "./dist/erosion.d.ts",
      "import": "./dist/erosion.js"
    },
    "./relief": {
      "types": "./dist/relief.d.ts",
      "import": "./dist/relief.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "import": "./dist/digest.js"
    },
    "./koppen": {
      "types": "./dist/koppen.d.ts",
      "import": "./dist/koppen.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./rivers": {
      "types": "./dist/rivers.d.ts",
      "import": "./dist/rivers.js"
    },
    "./cover": {
      "types": "./dist/cover.d.ts",
      "import": "./dist/cover.js"
    },
    "./far": {
      "types": "./dist/far.d.ts",
      "import": "./dist/far.js"
    },
    "./objects": {
      "types": "./dist/objects.d.ts",
      "import": "./dist/objects.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./placement": {
      "types": "./dist/placement.d.ts",
      "import": "./dist/placement.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "import": "./dist/io.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/terrain": "^1.0.0",
    "@margoengine/scatter": "^1.0.0",
    "@margoengine/procedural": "^1.0.0",
    "@margoengine/water": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/core": {
      "optional": true
    },
    "@margoengine/terrain": {
      "optional": true
    },
    "@margoengine/scatter": {
      "optional": true
    },
    "@margoengine/procedural": {
      "optional": true
    },
    "@margoengine/water": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "margo": {
    "gpuTestTimeoutMinutes": {
      "test:gpu:flythrough": 12.5
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js biomes",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/biomes/tests/browser-check.mjs && node packages/biomes/tests/water-check.mjs",
    "test:gpu:objects": "cd ../.. && node packages/biomes/tests/objects-check.mjs",
    "test:gpu:shadows": "cd ../.. && node packages/biomes/tests/shadows-check.mjs",
    "test:gpu:flythrough": "cd ../.. && node packages/biomes/tests/flythrough-check.mjs",
    "test:gpu:objects-frame": "cd ../.. && node packages/biomes/tests/objects-frame-check.mjs",
    "test:gpu:backend": "cd ../.. && node packages/biomes/tests/gpu-backend-check.mjs",
    "test:gpu:backend-placement": "cd ../.. && node packages/biomes/tests/gpu-backend-placement-check.mjs"
  }
}
