{
  "name": "@margoengine/ragdoll",
  "version": "1.0.0",
  "description": "Ragdolls on Rapier physics: capsule bodies from a skeleton, cone and hinge joint limits, kinematic hit boxes, going limp and blending back to the animation.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "ragdoll",
    "physics",
    "rapier",
    "animation"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/ragdoll"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/physics": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js ragdoll",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  }
}
