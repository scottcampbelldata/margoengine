{
  "name": "@margoengine/controls",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Orbit, map, trackball, fly, first-person, pointer-lock camera controls, a transform gizmo and drag controls for Margo Engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/controls"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "size": "npm run build && node scripts/size.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^0.1.0 || ^1.0.0",
    "@margoengine/bvh": "^0.1.0 || ^1.0.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "0.1.0"
  }
}
