{
  "name": "@margoengine/controls",
  "version": "1.0.0",
  "description": "Orbit, map, trackball, arcball, fly, first-person, pointer-lock and collision-aware walkthrough (/walk) camera controls, a transform gizmo and drag controls for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "controls"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/controls"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "size": "npm run build && node scripts/size.js",
    "prepack": "npm run build",
    "test:browser:walk": "npm run build && node scripts/test-walk-browser.js",
    "test:browser:globe": "npm run build && node scripts/test-optional-browser.js globe",
    "test:browser:collide": "npm run build && node scripts/test-optional-browser.js collide",
    "test:browser:box-gizmo": "npm run build && node scripts/test-optional-browser.js box-gizmo",
    "test:browser:presentation": "npm run build && node scripts/test-optional-browser.js presentation",
    "test:browser:device-orientation": "npm run build && node scripts/test-optional-browser.js device-orientation"
  },
  "sideEffects": false,
  "exports": {
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/transitions.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "import": "./dist/orbit.js"
    },
    "./fly": {
      "types": "./dist/fly.d.ts",
      "import": "./dist/fly.js"
    },
    "./trackball": {
      "types": "./dist/trackball.d.ts",
      "import": "./dist/trackball.js"
    },
    "./arcball": {
      "types": "./dist/arcball.d.ts",
      "import": "./dist/arcball.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "import": "./dist/transform.js"
    },
    "./drag": {
      "types": "./dist/drag.d.ts",
      "import": "./dist/drag.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    },
    "./third-person": {
      "types": "./dist/third-person.d.ts",
      "import": "./dist/third-person.js"
    },
    "./walk": {
      "types": "./dist/walk.d.ts",
      "import": "./dist/walk.js"
    },
    "./globe": {
      "types": "./dist/globe.d.ts",
      "import": "./dist/globe.js"
    },
    "./collide": {
      "types": "./dist/collide.d.ts",
      "import": "./dist/collide.js"
    },
    "./box-gizmo": {
      "types": "./dist/box-gizmo.d.ts",
      "import": "./dist/box-gizmo.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./device-orientation": {
      "types": "./dist/device-orientation.d.ts",
      "import": "./dist/device-orientation.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/tween": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/tween": {
      "optional": true
    }
  }
}
