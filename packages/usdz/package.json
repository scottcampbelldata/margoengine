{
  "name": "@margoengine/usdz",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Optional static USDA, USDC and USDZ ingestion through Margo glTF PBR.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
