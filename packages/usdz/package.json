{
  "name": "@margoengine/usdz",
  "version": "1.0.0",
  "description": "Optional static USDA, USDC and USDZ ingestion through Margo glTF PBR.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "usd",
    "usdz"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/usdz"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./skel": {
      "types": "./dist/skel.d.ts",
      "import": "./dist/skel.js"
    },
    "./anim": {
      "types": "./dist/anim.d.ts",
      "import": "./dist/anim.js"
    },
    "./subdiv": {
      "types": "./dist/subdiv.d.ts",
      "import": "./dist/subdiv.js"
    },
    "./lux": {
      "types": "./dist/lux.d.ts",
      "import": "./dist/lux.js"
    },
    "./materialx": {
      "types": "./dist/materialx.d.ts",
      "import": "./dist/materialx.js"
    },
    "./instancer": {
      "types": "./dist/instancer.d.ts",
      "import": "./dist/instancer.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "import": "./dist/shapes.js"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js"
    },
    "./preview-surface": {
      "types": "./dist/preview-surface.d.ts",
      "import": "./dist/preview-surface.js"
    },
    "./clips": {
      "types": "./dist/clips.d.ts",
      "import": "./dist/clips.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js usdz",
    "test": "npm run build && node --test tests/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/lines": "^1.0.0",
    "@margoengine/points": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/loaders": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
