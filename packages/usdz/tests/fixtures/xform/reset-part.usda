#usda 1.0
(
    defaultPrim = "Part"
)

def Xform "Part"
{
    def Mesh "Pinned"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate:at = (0, 5, 0)
        uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate:at"]
    }
}

