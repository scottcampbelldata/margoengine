#usda 1.0
(
    defaultPrim = "M"
)
class "C"
{
    custom double v2 = 852
    custom double v3 = 588
    custom rel r = [</C/b>]
    def "c" (
        variantSets = "vs"
        variants = { string vs = "y" }
    )
    {
        custom double v1.timeSamples = { 3: 98, 4: 40 }
        over "a" (
            variantSets = "vs"
        )
        {
            custom double v0.timeSamples = { 3: 86, 9: 89 }
            custom double v2 = 492
            custom double v3 = None
            append rel r = [</M/a>]
            variantSet "vs" = {
                "x" {
                    custom double v0 = 927
                    custom double v2 = 352
                    custom double v3 = 347
                }
                "y" {
                    custom double v0 = 577
                    custom double v1 = None
                    custom double v2 = 656
                    custom double v3 = 901
                    def "c"
                    {
                        custom double v1 = 240
                    }
                }
            }
        }
        over "c"
        {
            custom double v0 = 615
            custom double v1 = 418
            custom double v3 = None
        }
        variantSet "vs" = {
            "x" {
                custom double v3 = 942
            }
            "y" {
                custom double v1 = None
                def "c"
                {
                    custom double v0 = 630
                    custom double v2 = 369
                    custom double v3 = 826
                    prepend rel r = [</M/a>]
                }
            }
        }
    }
}
def "Shared"
{
    custom double v0 = 319
    custom double v2 = None
    over "c"
    {
        custom double v0 = 792
        custom double v1 = 820
    }
}
def "M" (
    append inherits = </C/a>
)
{
    custom double v0 = 205
    custom double v1.timeSamples = { 3: 47, 9: 49 }
    custom double v2.timeSamples = { 0: 22, 8: 90 }
    over "a" (
        references = </Shared>
    )
    {
        custom double v1 = 806
        custom double v2 = 144
        custom double v3 = 293
        def "a" (
            append references = @./l0.usda@ (offset = 3; scale = 2)
        )
        {
            custom double v0 = 336
            custom double v1.timeSamples = { 2: 49, 6: 94 }
        }
    }
    over "b"
    {
        custom double v0 = 825
        custom double v1 = 965
        custom double v3 = 362
        custom rel r = [</M/a>]
    }
}
over "Y" (
    append inherits = </C>
)
{
    custom double v0 = 836
    custom double v2 = 295
    custom double v3 = 926
    def "b" (
        inherits = </C>
        variantSets = "vs"
        variants = { string vs = "x" }
    )
    {
        custom double v0 = 861
        custom double v1 = 84
        custom double v2 = 128
        variantSet "vs" = {
            "x" {
                custom double v0 = None
                custom double v1 = 821
            }
            "y" {
                custom double v1 = 539
                custom double v2 = 835
                custom double v3 = 889
            }
        }
    }
}
