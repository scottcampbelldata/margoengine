#usda 1.0
(
    defaultPrim = "M"
)
class "C"
{
    custom double v3 = 796
    prepend rel r = [</Shared>]
    def "a"
    {
        custom double v0 = 497
        custom double v1 = 24
        custom double v3 = 871
        over "a" (
            variantSets = "vs"
            variants = { string vs = "y" }
        )
        {
            custom double v0 = 434
            custom double v3 = None
            variantSet "vs" = {
                "x" {
                    custom double v0 = 72
                    custom double v2 = 46
                    def "c"
                    {
                        custom double v0 = 1
                        custom double v3 = None
                        append rel r = [</Shared>]
                    }
                }
                "y" {
                    custom double v1.timeSamples = { 2: 78, 5: 11 }
                    def "c"
                    {
                        custom double v0 = 332
                        custom double v1.timeSamples = { 1: 32, 9: 6 }
                        custom double v2 = 526
                        custom double v3 = 580
                        custom rel r = [</M/a>]
                    }
                }
            }
        }
        def "b"
        {
            custom double v0 = 536
            custom double v1.timeSamples = { 3: 91, 6: 14 }
            custom double v2 = 339
            custom double v3 = 396
        }
    }
}
def "Shared"
{
    append rel r = [</C/b>]
    def "b"
    {
        custom double v0 = None
        custom double v1.timeSamples = { 2: 34, 7: 9 }
        append rel r = [</Shared>]
    }
}
def "M" (
    specializes = </C/a>
