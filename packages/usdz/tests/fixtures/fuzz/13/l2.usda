            )
            {
                custom double v1 = 873
                custom double v3 = 218
                variantSet "vs" = {
                    "x" {
                        custom double v0 = 776
                        custom double v2 = 310
                        append rel r = [</C/b>]
                        def "b" (
                            append references = @./l1.usda@ (offset = 10)
                        )
                        {
                            custom double v0 = 195
