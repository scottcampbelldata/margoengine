        {
            custom double v1 = 23
            custom double v2 = 499
            prepend rel r = [</C/b>]
        }
        variantSet "vs" = {
            "x" {
                custom double v0 = 241
                custom double v1 = 558
                custom double v3 = 75
            }
            "y" {
