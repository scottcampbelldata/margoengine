#usda 1.0
(
    defaultPrim = "M"
)
class "C"
{
    custom double v0.timeSamples = { 3: 79, 8: 91 }
    custom double v1 = 728
    custom double v2.timeSamples = { 3: 49, 7: 39 }
}
def "Shared" (
    variantSets = "vs"
    variants = { string vs = "x" }
)
{
    custom double v1 = 86
    variantSet "vs" = {
        "x" {
            custom double v2 = 472
            custom double v3 = 460
        }
        "y" {
            custom double v2 = 732
            custom double v3 = None
        }
    }
}
def "M"
{
    custom double v0 = None
    custom double v1 = 556
    custom double v2 = 73
    custom double v3 = 785
    over "a"
    {
        custom double v0 = None
        custom double v1 = 239
        custom double v2 = 73
        delete rel r = [</Shared>]
        def "b" (
            prepend inherits = </C>
        )
        {
            custom double v0 = 14
            custom double v1 = 143
            custom double v2.timeSamples = { 0: 73, 4: 83 }
        }
        def "c" (
            append inherits = </C>
        )
        {
            custom double v1 = 38
            custom double v2 = None
        }
    }
    over "b" (
        references = </Shared>
    )
    {
        custom double v1 = 165
        custom double v3 = 734
        append rel r = [</Shared>]
        def "a" (
            specializes = </C/a>
            references = </Shared>
        )
        {
            custom double v1.timeSamples = { 0: 39, 5: 76 }
            custom double v3 = 190
        }
    }
}
over "Y" (
    variantSets = "vs"
    variants = { string vs = "y" }
)
{
    custom double v2 = 799
    custom double v3 = 778
    prepend rel r = [</M/a>]
    over "c" (
        prepend inherits = </C>
    )
    {
        custom double v2 = 353
        prepend rel r = [</Shared>]
    }
    variantSet "vs" = {
        "x" {
            custom double v1 = 891
            def "b" (
                prepend inherits = </C>
            )
            {
                custom double v0 = 521
                custom double v1 = None
                custom double v2.timeSamples = { 1: 41, 6: 73 }
                add rel r = [</C/b>]
            }
        }
        "y" {
            custom double v0.timeSamples = { 1: 10, 6: 58 }
            custom double v3.timeSamples = { 3: 40, 6: 91 }
        }
    }
}
