#usda 1.0
(
    defaultPrim = "M"
)
class "C"
{
    custom double v0 = 408
    custom double v1 = 267
    custom double v3.timeSamples = { 1: 38, 6: 16 }
    def "a"
    {
        custom double v0.timeSamples = { 2: 99, 9: 68 }
        custom double v2 = 629
        delete rel r = [</C/b>]
        def "b"
        {
            custom double v1.timeSamples = { 3: 9, 4: 10 }
            custom double v3 = 397
            prepend rel r = [</C/b>]
        }
    }
}
def "Shared"
{
    custom double v0 = 261
    custom double v1 = 809
    custom double v3 = 429
}
def "M" (
    variantSets = "vs"
    variants = { string vs = "y" }
)
{
    custom double v0 = 770
    custom double v1 = 785
    custom double v2 = 723
    custom double v3 = 660
    variantSet "vs" = {
        "x" {
            custom double v0 = 243
            custom double v1.timeSamples = { 1: 94, 4: 49 }
            custom double v2.timeSamples = { 3: 46, 7: 51 }
            custom double v3 = 397
            def "a" (
                specializes = </C/a>
            )
            {
                custom double v2 = 134
                delete rel r = [</C/b>]
            }
        }
        "y" {
            custom double v1 = 578
            custom double v3 = 691
        }
    }
}
def "Y" (
    prepend inherits = </C>
)
{
    custom double v0 = None
    def "b" (
        prepend inherits = </C>
        variantSets = "vs"
    )
    {
        custom double v1 = 280
        custom double v2 = 571
        custom double v3 = 161
        add rel r = [</Shared>]
        variantSet "vs" = {
            "x" {
                custom double v1 = None
                custom double v2.timeSamples = { 2: 6, 5: 60 }
                custom double v3 = 118
            }
            "y" {
                custom rel r = [</Y>]
                def "a"
                {
                    custom double v0.timeSamples = { 3: 7, 4: 25 }
                    custom double v1 = 848
                    custom double v3 = 543
                    prepend rel r = [</Shared>]
                }
            }
        }
    }
}
