    custom double v3.timeSamples = { 3: 10, 4: 90 }
    append rel r = [</C/b>]
    def "b"
    {
        custom double v0.timeSamples = { 1: 9, 4: 76 }
        custom double v1 = 526
        custom double v3 = 188
        def "b"
        {
            custom double v2 = 251
            custom double v3 = 548
            add rel r = [</C/b>]
        }
    }
    def "c"
    {
        custom double v0 = 435
        custom double v1.timeSamples = { 2: 84, 5: 38 }
        custom double v3 = 760
    }
}
def "Shared"
{
    custom double v0 = 540
    custom double v3 = 420
    delete rel r = [</C/b>]
    def "a"
    {
        custom double v0 = 492
        custom double v1 = None
        custom double v3.timeSamples = { 3: 1, 5: 66 }
    }
    over "b"
    {
        custom double v0 = 172
        custom double v1.timeSamples = { 1: 19, 9: 57 }
        custom double v2 = 901
        custom double v3 = 892
        prepend rel r = [</M/a>]
    }
}
def "M"
{
    custom double v2 = 809
    custom double v3 = 290
    custom rel r = [</M/a>]
}
def "Y" (
    append inherits = </C>
)
{
