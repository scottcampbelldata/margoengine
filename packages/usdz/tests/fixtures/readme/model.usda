#usda 1.0
(
    defaultPrim = "Model"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Model" (
    variants = {
        string shadingVariant = "blue"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Mesh "Quad"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.5, 0, 0), (0.5, 0, 0), (0.5, 1, 0), (-0.5, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
    variantSet "shadingVariant" = {
        "blue" {
            over "Quad"
            {
                color3f[] primvars:displayColor = [(0.1, 0.2, 0.9)]
            }
        }
        "red" {
            over "Quad"
            {
                color3f[] primvars:displayColor = [(0.9, 0.1, 0.1)]
            }
        }
    }
}
