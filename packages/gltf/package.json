{
  "name": "@margoengine/gltf",
  "version": "1.0.0",
  "description": "glTF 2.0 for Margo Engine: a light static loader at the root, metallic-roughness PBR rendering at @margoengine/gltf/pbr.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "gltf",
    "glb",
    "loader",
    "pbr"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/gltf"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-name-pattern=\"glTF loader|GLB,\" ../../tests/modern.test.js && node --test test/*.test.js ../../tests/modern-extensions.test.js ../../tests/modern-gltf*.test.js ../../tests/gltf-draco-limits.test.js ../../tests/deep-render-pbr-resources.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "node ../../scripts/test-gltf-browser.mjs",
    "test:shader:browser": "cd ../.. && node packages/gltf/scripts/test-shader-review.js",
    "test:extensions:browser": "cd ../.. && node packages/gltf/scripts/test-extensions-browser.js",
    "test:gpu:materials": "cd ../.. && node scripts/gltf-pbr-materials-gpu-check.js",
    "test:gpu:viewer": "cd ../.. && node scripts/stage-viewer-gpu-check.js && node scripts/stage-viewer-gpu-check.js --compat",
    "test:gpu:native-volume": "cd ../.. && node packages/gltf/scripts/test-native-volume.mjs && node packages/gltf/scripts/test-native-volume.mjs --compat",
    "test:gpu:transmission": "cd ../.. && node packages/gltf/scripts/test-screen-transmission-browser.mjs && node packages/gltf/scripts/test-screen-transmission-browser.mjs --compat",
    "test:gpu:spec-gloss": "cd ../.. && node packages/gltf/scripts/test-spec-gloss-browser.mjs && node packages/gltf/scripts/test-spec-gloss-browser.mjs --compat",
    "test:gpu:colour-space": "cd ../.. && node packages/gltf/scripts/test-extended-colour-space-browser.mjs && node packages/gltf/scripts/test-extended-colour-space-browser.mjs --compat",
    "test:gpu:dds": "cd ../.. && node packages/gltf/scripts/test-dds-browser.mjs && node packages/gltf/scripts/test-dds-browser.mjs --compat",
    "test:gpu:mask-mips": "cd ../.. && node packages/gltf/scripts/test-mask-mips-browser.mjs && node packages/gltf/scripts/test-mask-mips-browser.mjs --compat",
    "test:gpu:mipmaps": "cd ../.. && node packages/gltf/scripts/test-mipmaps-browser.mjs && node packages/gltf/scripts/test-mipmaps-browser.mjs --compat",
    "test:gpu:diffuse-roughness": "cd ../.. && node packages/gltf/scripts/test-diffuse-roughness-browser.mjs && node packages/gltf/scripts/test-diffuse-roughness-browser.mjs --compat",
    "test:gpu:parts": "cd ../.. && node packages/gltf/scripts/test-parts-browser.mjs && node packages/gltf/scripts/test-parts-browser.mjs --compat",
    "test:gpu:skinned-parts": "cd ../.. && node packages/gltf/scripts/test-skinned-parts-browser.mjs && node packages/gltf/scripts/test-skinned-parts-browser.mjs --compat",
    "test:gpu:mask-alpha": "cd ../.. && node packages/gltf/scripts/test-mask-alpha-browser.mjs && node packages/gltf/scripts/test-mask-alpha-browser.mjs --compat",
    "test:gpu:progressive": "cd ../.. && node packages/gltf/scripts/test-progressive-browser.mjs && node packages/gltf/scripts/test-progressive-browser.mjs --compat",
    "test:gpu:base-textures": "cd ../.. && node packages/gltf/scripts/test-base-textures-browser.mjs && node packages/gltf/scripts/test-base-textures-browser.mjs --compat",
    "test:browser:audio": "cd ../.. && node packages/gltf/scripts/test-audio-browser.mjs",
    "test:gpu:pixel-images": "cd ../.. && node packages/gltf/scripts/test-node-images.mjs && node packages/gltf/scripts/test-pixel-images.mjs && node packages/gltf/scripts/test-pixel-images.mjs --compat",
    "test:gpu:compression": "cd ../.. && npm run modern:test:gltf-compression",
    "test:gpu:strokes": "cd ../.. && node packages/gltf/scripts/test-strokes-browser.mjs && node packages/gltf/scripts/test-strokes-browser.mjs --compat",
    "test:gpu:soft-mesh": "cd ../.. && node packages/gltf/scripts/test-soft-mesh-browser.mjs && node packages/gltf/scripts/test-soft-mesh-browser.mjs --compat"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
