{
  "name": "@margoengine/gltf",
  "version": "1.0.0",
  "description": "Lazy static glTF/GLB loading for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "gltf",
    "glb",
    "loader"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/gltf"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js && node --test --test-name-pattern=\"glTF loader|GLB,\" ../../tests/modern.test.js",
    "test:gpu": "node ../../scripts/test-gltf-browser.mjs",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./instancing": {
      "types": "./dist/instancing.d.ts",
      "import": "./dist/instancing.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    },
    "./quantized": {
      "types": "./dist/quantized.d.ts",
      "import": "./dist/quantized.js"
    },
    "./scene-data": {
      "types": "./dist/scene-data.d.ts",
      "import": "./dist/scene-data.js"
    },
    "./textured": {
      "types": "./dist/textured.d.ts",
      "import": "./dist/textured.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/decoders": {
      "optional": true
    },
    "@margoengine/gltf-pro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  }
}
