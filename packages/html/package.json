{
  "name": "@margoengine/html",
  "version": "1.0.0",
  "description": "World-space DOM anchors, CSS3D placement and scene-depth occlusion.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "html"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/html"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./texture-gl": {
      "types": "./dist/texture-gl.d.ts",
      "import": "./dist/texture-gl.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/labels": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js html",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  }
}
