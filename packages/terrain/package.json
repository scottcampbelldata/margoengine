{
  "name": "@margoengine/terrain",
  "version": "1.0.0",
  "description": "Geometry clipmaps and triplanar terrain layers.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "terrain"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/terrain"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js terrain",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "cd ../.. && node packages/terrain/test/wetness.browser.mjs && node packages/terrain/test/edge.browser.mjs && node packages/terrain/test/bump.browser.mjs && node packages/terrain/test/crest.browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
