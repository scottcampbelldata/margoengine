{
  "name": "@margoengine/voxel",
  "version": "1.0.0",
  "description": "Voxel worlds: a block-type registry, 32-cubed palette chunks with light bytes, and a chunked world with dirty tracking and change events.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./bevel": {
      "types": "./dist/bevel.d.ts",
      "import": "./dist/bevel.js"
    },
    "./mesher": {
      "types": "./dist/mesher.d.ts",
      "import": "./dist/mesher.js"
    },
    "./light": {
      "types": "./dist/light.d.ts",
      "import": "./dist/light.js"
    },
    "./vox": {
      "types": "./dist/vox.d.ts",
      "import": "./dist/vox.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./lightmap": {
      "types": "./dist/lightmap.d.ts",
      "import": "./dist/lightmap.js"
    },
    "./lod": {
      "types": "./dist/lod.d.ts",
      "import": "./dist/lod.js"
    },
    "./light-worker": {
      "types": "./dist/light-worker.d.ts",
      "import": "./dist/light-worker.js"
    },
    "./light-rgb": {
      "types": "./dist/light-rgb.d.ts",
      "import": "./dist/light-rgb.js"
    },
    "./fluids": {
      "types": "./dist/fluids.d.ts",
      "import": "./dist/fluids.js"
    },
    "./ticks": {
      "types": "./dist/ticks.d.ts",
      "import": "./dist/ticks.js"
    },
    "./gpu-mesher": {
      "types": "./dist/gpu-mesher.d.ts",
      "import": "./dist/gpu-mesher.js"
    },
    "./smooth": {
      "types": "./dist/smooth.d.ts",
      "import": "./dist/smooth.js"
    },
    "./gi": {
      "types": "./dist/gi.d.ts",
      "import": "./dist/gi.js"
    },
    "./debris": {
      "types": "./dist/debris.d.ts",
      "import": "./dist/debris.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/physics": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/physics": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/procedural": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/voxel/tests/render-browser-check.mjs && node packages/voxel/tests/bevel-browser-check.mjs && node packages/voxel/tests/render-lighting-browser-check.mjs && node packages/voxel/tests/lod-browser-check.mjs && node packages/voxel/tests/light-rgb-browser-check.mjs && node packages/voxel/tests/gpu-mesher-browser-check.mjs && node packages/voxel/tests/smooth-browser-check.mjs && node packages/voxel/tests/gi-browser-check.mjs && node packages/voxel/tests/debris-browser-check.mjs",
    "test:gpu:slow-compile": "cd ../.. && node packages/voxel/tests/bevel-browser-check.mjs --pipeline-delay=500",
    "test:gpu:slow-mesh": "cd ../.. && node packages/voxel/tests/bevel-browser-check.mjs --worker-delay=150"
  },
  "margo": {
    "gpuTestSteps": {
      "test:gpu:slow-compile": [
        "--samples=4",
        "--samples=1"
      ],
      "test:gpu:slow-mesh": [
        "--samples=4",
        "--samples=1"
      ]
    }
  }
}
