{
  "name": "@margoengine/tilemap",
  "version": "1.0.0",
  "description": "2D tile maps for Margo Engine: the TileMapData format (tilesets, animated tiles, collision shapes, tile and object layers, parallax) shared by the renderer, auto-tiling and the Tiled and LDtk importers.",
  "keywords": [
    "margoengine",
    "webgpu",
    "2d",
    "tilemap"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/tilemap"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autotile": {
      "types": "./dist/autotile.d.ts",
      "import": "./dist/autotile.js"
    },
    "./tiled": {
      "types": "./dist/tiled.d.ts",
      "import": "./dist/tiled.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js tilemap",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
