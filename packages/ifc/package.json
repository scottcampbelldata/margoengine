{
  "name": "@margoengine/ifc",
  "version": "1.0.0",
  "description": "IFC geometry and BIM identifiers for Margo Engine, using an initialized web-ifc runtime.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "ifc",
    "bim"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/ifc"
  },
  "license": "MIT",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/ifc.test.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/loaders": "^1.0.0",
    "web-ifc": "^0.0.78"
  },
  "peerDependenciesMeta": {
    "web-ifc": {
      "optional": true
    }
  }
}
