{
  "name": "@margoengine/clustered",
  "version": "1.0.0",
  "description": "WebGPU clustered forward point and spot lighting with optional local shadows.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "clustered"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/clustered"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js test/*.test.js",
    "test:gpu": "cd ../.. && node packages/shadows/test/cutout-casters-browser.mjs",
    "test:gpu:area": "cd ../.. && node examples/package-benchmarks/area-lights-gpu.mjs",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shadows": {
      "types": "./dist/shadows.d.ts",
      "import": "./dist/shadows.js"
    },
    "./area": {
      "types": "./dist/area.d.ts",
      "import": "./dist/area.js"
    },
    "./directional": {
      "types": "./dist/directional.d.ts",
      "import": "./dist/directional.js"
    },
    "./ies": {
      "types": "./dist/ies.d.ts",
      "import": "./dist/ies.js"
    },
    "./projector": {
      "types": "./dist/projector.d.ts",
      "import": "./dist/projector.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./flicker": {
      "types": "./dist/flicker.d.ts",
      "import": "./dist/flicker.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "import": "./dist/budget.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
