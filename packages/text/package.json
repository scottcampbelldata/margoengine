{
  "name": "@margoengine/text",
  "version": "1.0.0",
  "description": "GPU signed distance field text for Margo Engine: runtime glyph atlases from any browser font, wrapping, alignment, outlines and shadows, WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "text"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/text"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test --test-timeout=240000 tests/curve.test.js tests/renderer-dispose.test.js tests/msdf.test.js tests/selection.test.js tests/fit.test.js tests/text.test.js tests/layout-workcount.test.js tests/sdf.test.js tests/compose.test.js tests/rich.test.js tests/animate.test.js tests/extrude*.test.js tests/vector.test.js tests/outline.test.js tests/outline-msdf.test.js tests/opentype-optin.test.js tests/captions.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "npm run build && node scripts/test-browser.js && node scripts/test-vector-browser.js",
    "prepack": "npm run build",
    "test:gpu:outline": "cd ../.. && node packages/text/tests/outline-node-gpu.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rich": {
      "types": "./dist/rich.d.ts",
      "import": "./dist/rich.js"
    },
    "./msdf": {
      "types": "./dist/msdf.d.ts",
      "import": "./dist/msdf.js"
    },
    "./animate": {
      "types": "./dist/animate.d.ts",
      "import": "./dist/animate.js"
    },
    "./extrude": {
      "types": "./dist/extrude.d.ts",
      "import": "./dist/extrude.js"
    },
    "./fit": {
      "types": "./dist/fit.d.ts",
      "import": "./dist/fit.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js"
    },
    "./curve": {
      "types": "./dist/curve.d.ts",
      "import": "./dist/curve.js"
    },
    "./vector": {
      "types": "./dist/vector.d.ts",
      "import": "./dist/vector.js"
    },
    "./outline": {
      "types": "./dist/outline.d.ts",
      "import": "./dist/outline.js"
    },
    "./captions": {
      "types": "./dist/captions.d.ts",
      "import": "./dist/captions.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/loaders": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  }
}
