{
  "name": "@margoengine/lightmap",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "CPU lightmap atlases with native albedo, emission, normal and ORM textures; optional area lights, emissive surfaces, bounces and glass (./global) and caustics (./refracted).",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./refracted": {
      "types": "./dist/refracted.d.ts",
      "import": "./dist/refracted.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js lightmap",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "homepage": "https://margoengine.com"
}
