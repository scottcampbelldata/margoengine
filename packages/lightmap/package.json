{
  "name": "@margoengine/lightmap",
  "version": "1.0.0",
  "description": "CPU lightmap atlases with native albedo, emission, normal and ORM textures; triangle meshes at their own UV1 (./mesh), also progressively on the GPU (./gpu), with directional lightmaps (./directional) and irradiance probes from the same scene (./probes); optional area lights, emissive surfaces, bounces and glass (./global), caustics through rough and dispersive glass with bounces (./refracted) and an edge-avoiding a-trous denoiser (./denoise).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "lightmap"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/lightmap"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./refracted": {
      "types": "./dist/refracted.d.ts",
      "import": "./dist/refracted.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./directional": {
      "types": "./dist/directional.d.ts",
      "import": "./dist/directional.js"
    },
    "./imported": {
      "types": "./dist/imported.d.ts",
      "import": "./dist/imported.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./probes": {
      "types": "./dist/probes.d.ts",
      "import": "./dist/probes.js"
    },
    "./denoise": {
      "types": "./dist/denoise.d.ts",
      "import": "./dist/denoise.js"
    },
    "./apply": {
      "types": "./dist/apply.d.ts",
      "import": "./dist/apply.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js lightmap",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "node tests/gpu.browser.mjs",
    "test:browser:global": "node tests/global-browser.mjs",
    "test:browser:global:compat": "node tests/global-browser.mjs --compat"
  }
}
