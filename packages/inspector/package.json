{
  "name": "@margoengine/inspector",
  "version": "1.0.0",
  "description": "Entity hierarchy, live properties, WebGPU wireframe, normal and bounding-box overlays, and a frame debugger.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "inspector"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/inspector"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./packages": {
      "types": "./dist/packages.d.ts",
      "import": "./dist/packages.js"
    },
    "./tweak": {
      "types": "./dist/tweak.d.ts",
      "import": "./dist/tweak.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js"
    },
    "./gizmo": {
      "types": "./dist/gizmo.d.ts",
      "import": "./dist/gizmo.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "import": "./dist/textures.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/lines": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "@margoengine/stats": "^1.0.0",
    "@margoengine/controls": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/clustered": "^1.0.0",
    "@margoengine/scene": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/animation": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animation": { "optional": true }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js inspector",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:browser:animation": "node test/animation-browser.mjs",
    "test:browser:animation:compat": "node test/animation-browser.mjs --compat",
    "test:browser": "node test/parity-browser.mjs",
    "test:browser:compat": "node test/parity-browser.mjs --compat",
    "test:browser:gizmo": "node test/gizmo-browser.mjs",
    "test:browser:gizmo:compat": "node test/gizmo-browser.mjs --compat",
    "test:browser:edit": "node test/edit-browser.mjs",
    "test:browser:edit:compat": "node test/edit-browser.mjs --compat",
    "test:browser:textures": "node test/textures-browser.mjs",
    "test:browser:textures:compat": "node test/textures-browser.mjs --compat"
  }
}
