{
  "name": "@margoengine/inspector",
  "version": "0.1.0",
  "description": "Entity hierarchy, live properties, WebGPU wireframe, normal and bounding-box overlays, and a frame debugger.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "inspector"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/inspector"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./packages": {
      "types": "./dist/packages.d.ts",
      "import": "./dist/packages.js"
    },
    "./tweak": {
      "types": "./dist/tweak.d.ts",
      "import": "./dist/tweak.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js"
    },
    "./gizmo": {
      "types": "./dist/gizmo.d.ts",
      "import": "./dist/gizmo.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "import": "./dist/textures.js"
    },
    "./gl": {
      "types": "./dist/gl.d.ts",
      "import": "./dist/gl.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./mesh-debug": {
      "types": "./dist/mesh-debug.d.ts",
      "import": "./dist/mesh-debug.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./remote-relay": {
      "types": "./dist/remote-relay.d.ts",
      "import": "./dist/remote-relay.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/lines": "^0.1.0",
    "@margoengine/math": "^0.1.0",
    "@margoengine/stats": "^0.1.0",
    "@margoengine/controls": "^0.1.0",
    "@margoengine/geometry": "^0.1.0",
    "@margoengine/clustered": "^0.1.0",
    "@margoengine/scene": "^0.1.0",
    "@margoengine/video": "^0.1.0",
    "@margoengine/exporters": "^0.1.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^0.1.0",
    "@margoengine/animation": "^0.1.0",
    "@margoengine/gltf": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animation": {
      "optional": true
    },
    "@margoengine/gltf": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js inspector",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:browser:animation": "node test/animation-browser.mjs",
    "test:browser:animation:compat": "node test/animation-browser.mjs --compat",
    "test:browser": "node test/parity-browser.mjs",
    "test:browser:compat": "node test/parity-browser.mjs --compat",
    "test:browser:gizmo": "node test/gizmo-browser.mjs",
    "test:browser:gizmo:compat": "node test/gizmo-browser.mjs --compat",
    "test:browser:edit": "node test/edit-browser.mjs",
    "test:browser:edit:compat": "node test/edit-browser.mjs --compat",
    "test:browser:textures": "node test/textures-browser.mjs",
    "test:browser:textures:compat": "node test/textures-browser.mjs --compat",
    "test:browser:gl": "node test/gl-browser.mjs",
    "test:browser:gl:compat": "node test/gl-browser.mjs --compat",
    "test:browser:tools": "node test/tools-browser.mjs",
    "test:browser:tools:compat": "node test/tools-browser.mjs --compat",
    "test:browser:shaders": "node test/shaders-browser.mjs",
    "test:browser:remote": "node test/remote-browser.mjs",
    "test:browser:mesh-debug": "node test/mesh-debug-browser.mjs",
    "test:browser:mesh-debug:compat": "node test/mesh-debug-browser.mjs --compat"
  }
}
