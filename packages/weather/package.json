{
  "name": "@margoengine/weather",
  "version": "1.0.0",
  "description": "Weather over time: a state machine with presets that blends rain, snow, hail, wind and lightning; a deterministic wind field; wet and snowy surface hooks in JavaScript and WGSL; helpers for the sky's Weather; and bouncing GPU hail.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "weather",
    "rain",
    "snow",
    "hail",
    "wind",
    "particles"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/weather"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hail": {
      "types": "./dist/hail.d.ts",
      "import": "./dist/hail.js"
    },
    "./puddles": {
      "types": "./dist/puddles.d.ts",
      "import": "./dist/puddles.js"
    },
    "./snow": {
      "types": "./dist/snow.d.ts",
      "import": "./dist/snow.js"
    },
    "./regions": {
      "types": "./dist/regions.d.ts",
      "import": "./dist/regions.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "import": "./dist/drive.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./gltf": {
      "types": "./dist/gltf.d.ts",
      "import": "./dist/gltf.js"
    },
    "./lens": {
      "types": "./dist/lens.d.ts",
      "import": "./dist/lens.js"
    },
    "./cover": {
      "types": "./dist/cover.d.ts",
      "import": "./dist/cover.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/post": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/post": { "optional": true }
  },
  "dependencies": {
    "@margoengine/audio": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js weather",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu": "cd ../.. && node packages/weather/tests/browser-check.mjs",
    "prepack": "npm run build",
    "test:browser:parity": "cd ../.. && node packages/weather/tests/parity-browser.mjs gltf && node packages/weather/tests/parity-browser.mjs gltf --compat && node packages/weather/tests/parity-browser.mjs cover && node packages/weather/tests/parity-browser.mjs cover --compat && node packages/weather/tests/parity-browser.mjs lens && node packages/weather/tests/parity-browser.mjs lens --compat"
  }
}
