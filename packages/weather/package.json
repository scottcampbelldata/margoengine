{
  "name": "@margoengine/weather",
  "version": "1.0.0",
  "description": "Weather over time: a state machine with presets that blends rain, snow, hail, wind and lightning; a deterministic wind field; wet and snowy surface hooks in JavaScript and WGSL; snow avalanches with a powder cloud that run out, entrain the cover, break trees and settle; volcanic eruption columns with an umbrella cloud, ash fall and plume lightning; lava flows that run down the ground and crust over with glowing cracks, fountains, bombs and glow lights; snow that drifts, builds cornices, sloughs and carries a slab's slide state; helpers for the sky's Weather; and bouncing GPU hail.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "weather",
    "rain",
    "snow",
    "hail",
    "wind",
    "particles"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/weather"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hail": {
      "types": "./dist/hail.d.ts",
      "import": "./dist/hail.js"
    },
    "./hail-physics": {
      "types": "./dist/hail-physics.d.ts",
      "import": "./dist/hail-physics.js"
    },
    "./puddles": {
      "types": "./dist/puddles.d.ts",
      "import": "./dist/puddles.js"
    },
    "./snow": {
      "types": "./dist/snow.d.ts",
      "import": "./dist/snow.js"
    },
    "./snow-drift": {
      "types": "./dist/snow-drift.d.ts",
      "import": "./dist/snow-drift.js"
    },
    "./avalanche": {
      "types": "./dist/avalanche.d.ts",
      "import": "./dist/avalanche.js"
    },
    "./eruption": {
      "types": "./dist/eruption.d.ts",
      "import": "./dist/eruption.js"
    },
    "./turbulence": {
      "types": "./dist/turbulence.d.ts",
      "import": "./dist/turbulence.js"
    },
    "./boundary-layer": {
      "types": "./dist/boundary-layer.d.ts",
      "import": "./dist/boundary-layer.js"
    },
    "./precipitation": {
      "types": "./dist/precipitation.d.ts",
      "import": "./dist/precipitation.js"
    },
    "./surface-energy": {
      "types": "./dist/surface-energy.d.ts",
      "import": "./dist/surface-energy.js"
    },
    "./lava": {
      "types": "./dist/lava.d.ts",
      "import": "./dist/lava.js"
    },
    "./lava-settings": {
      "types": "./dist/lava-settings.d.ts",
      "import": "./dist/lava-settings.js"
    },
    "./regions": {
      "types": "./dist/regions.d.ts",
      "import": "./dist/regions.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "import": "./dist/drive.js"
    },
    "./synoptic": {
      "types": "./dist/synoptic.d.ts",
      "import": "./dist/synoptic.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./data": {
