{
  "name": "@margoengine/points",
  "version": "1.0.0",
  "description": "Large point clouds (PointCloud, PointsMaterial) and instanced sprites (SpriteBatch, SpriteMaterial) for Margo Engine, WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "points"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/points"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./las": {
      "types": "./dist/las.d.ts",
      "import": "./dist/las.js"
    },
    "./laz": {
      "types": "./dist/laz.d.ts",
      "import": "./dist/laz.js"
    },
    "./e57": {
      "types": "./dist/e57.d.ts",
      "import": "./dist/e57.js"
    },
    "./copc": {
      "types": "./dist/copc.d.ts",
      "import": "./dist/copc.js"
    },
    "./octree": {
      "types": "./dist/octree.d.ts",
      "import": "./dist/octree.js"
    },
    "./surfels": {
      "types": "./dist/surfels.d.ts",
      "import": "./dist/surfels.js"
    },
    "./potree": {
      "types": "./dist/potree.d.ts",
      "import": "./dist/potree.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./clip": {
      "types": "./dist/clip.d.ts",
      "import": "./dist/clip.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  }
}
