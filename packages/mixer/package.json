{
  "name": "@margoengine/mixer",
  "version": "1.0.0",
  "description": "Audio mixing and effects: buses with gain, mute, solo, sends and ducking; equaliser, filter, compressor, limiter, delay and reverb on Web Audio; positional emitters; deterministic offline rendering.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "audio",
    "mixer",
    "web-audio",
    "reverb",
    "equalizer",
    "ducking"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/mixer"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sidechain": {
      "types": "./dist/sidechain.d.ts",
      "import": "./dist/sidechain.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "import": "./dist/snapshots.js"
    },
    "./worklet": {
      "types": "./dist/worklet.d.ts",
      "import": "./dist/worklet.js"
    },
    "./reflections": {
      "types": "./dist/reflections.d.ts",
      "import": "./dist/reflections.js"
    },
    "./loudness": {
      "types": "./dist/loudness.d.ts",
      "import": "./dist/loudness.js"
    },
    "./stereo": {
      "types": "./dist/stereo.d.ts",
      "import": "./dist/stereo.js"
    },
    "./analyser": {
      "types": "./dist/analyser.d.ts",
      "import": "./dist/analyser.js"
    },
    "./fx": {
      "types": "./dist/fx.d.ts",
      "import": "./dist/fx.js"
    },
    "./dynamics": {
      "types": "./dist/dynamics.d.ts",
      "import": "./dist/dynamics.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js mixer",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  }
}
