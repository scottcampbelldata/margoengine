{
  "name": "@margoengine/loaders",
  "version": "1.0.0",
  "description": "PLY, STL, 3MF, PCD, OFF, XYZ, OBJ/MTL, COLLADA, Tiled TMX, VTK, NRRD, LDraw, Rhino 3DM, 3DS, LWO, AMF, MD2, PDB, KMZ, NURBS, LAS, OpenVDB, static USDA/USDZ, SVG and TrueType font loaders for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "loaders"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/loaders"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --experimental-test-module-mocks --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "test:render:browser": "npm run build && node scripts/test-render-browser.mjs",
    "fixtures": "node scripts/fetch-fixtures.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
