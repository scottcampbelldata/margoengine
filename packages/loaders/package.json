{
  "name": "@margoengine/loaders",
  "version": "1.0.0",
  "description": "PLY, 3MF, PCD, OFF, XYZ, OBJ/MTL, COLLADA, Tiled TMX, legacy VTK, static USDA/USDZ, SVG and TrueType font loaders for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "loaders"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/loaders"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/loaders.test.js tests/lzf.test.js tests/dxf.test.js tests/obj.test.js tests/dae.test.js tests/dae-animation.test.js tests/dae-cesium.test.js tests/dae-fixture.test.js tests/dae-scene.test.js tests/tmx.test.js tests/font.test.js tests/svg.test.js tests/mtl.test.js tests/mtl-vectors.test.js tests/outline-font.test.js tests/svg-vectors.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "test:render:browser": "npm run build && node scripts/test-render-browser.mjs",
    "fixtures": "node scripts/fetch-fixtures.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./usd": {
      "types": "./dist/usd.d.ts",
      "import": "./dist/usd.js"
    },
    "./font": {
      "types": "./dist/font.d.ts",
      "import": "./dist/font.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./mtl": {
      "types": "./dist/mtl.d.ts",
      "import": "./dist/mtl.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/materials": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  }
}
