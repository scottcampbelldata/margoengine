{
  "name": "@margoengine/decoders",
  "version": "1.0.0",
  "description": "Worker-pooled Draco geometry and KTX2/Basis texture decoding, and synchronous PNG, TGA, TIFF, DDS and KTX reading, for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "decoders"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/decoders"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "test:gpu:jpeg": "cd ../.. && node packages/decoders/tests/jpeg-browser.mjs",
    "test:gpu:node-gltf": "node scripts/test-node-gltf.mjs",
    "prepack": "npm run build",
    "test:browser:hdr6": "cd ../.. && node packages/decoders/tests/hdr6-browser.mjs",
    "test:browser:avif": "cd ../.. && node packages/decoders/tests/avif-browser.mjs",
    "test:avif:native": "node scripts/test-avif-native.mjs"
  },
  "sideEffects": false,
  "exports": {
    "./ktx2-hdr6": {
      "types": "./dist/ktx2-hdr6.d.ts",
      "import": "./dist/ktx2-hdr6.js"
    },
    "./zstd": {
      "types": "./dist/zstd.d.ts",
      "import": "./dist/zstd.js"
    },
    "./lz4": {
      "types": "./dist/lz4.d.ts",
      "import": "./dist/lz4.js"
    },
    "./jpeg": {
      "types": "./dist/jpeg.d.ts",
      "import": "./dist/jpeg.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js"
    },
    "./brotli": {
      "types": "./dist/brotli.d.ts",
      "import": "./dist/brotli.js"
    },
    "./bzip2": {
      "types": "./dist/bzip2.d.ts",
      "import": "./dist/bzip2.js"
    },
    "./xz": {
      "types": "./dist/xz.d.ts",
      "import": "./dist/xz.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./bc": {
      "types": "./dist/bc.d.ts",
      "import": "./dist/bc.js"
    },
    "./webp": {
      "types": "./dist/webp.d.ts",
      "import": "./dist/webp.js"
    },
    "./webp-lossless": {
      "types": "./dist/webp-lossless.d.ts",
      "import": "./dist/webp-lossless.js"
    },
    "./tga": {
      "types": "./dist/tga.d.ts",
      "import": "./dist/tga.js"
    },
    "./pcx": {
      "types": "./dist/pcx.d.ts",
      "import": "./dist/pcx.js"
    },
    "./dds": {
      "types": "./dist/dds.d.ts",
      "import": "./dist/dds.js"
    },
    "./ktx": {
      "types": "./dist/ktx.d.ts",
      "import": "./dist/ktx.js"
    },
    "./tiff": {
      "types": "./dist/tiff.d.ts",
      "import": "./dist/tiff.js"
    },
    "./ktx2-layers": {
      "types": "./dist/ktx2-layers.d.ts",
      "import": "./dist/ktx2-layers.js"
    },
    "./ktx2-hdr": {
      "types": "./dist/ktx2-hdr.d.ts",
      "import": "./dist/ktx2-hdr.js"
    },
    "./ktx2-gpu": {
      "types": "./dist/ktx2-gpu.d.ts",
