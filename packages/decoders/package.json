{
  "name": "@margoengine/decoders",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Worker-pooled Draco geometry and KTX2/Basis texture decoding for Margo Engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/decoders"
  },
  "peerDependencies": {
    "@margoengine/core": "^0.1.0 || ^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/decoders.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://margoengine.com"
}
