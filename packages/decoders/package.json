{
  "name": "@margoengine/decoders",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Worker-pooled Draco geometry and KTX2/Basis texture decoding, and synchronous PNG reading, for Margo Engine.",
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/decoders.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://margoengine.com"
}
