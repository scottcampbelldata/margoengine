    },
    "./jxl": {
      "types": "./dist/jxl.d.ts",
      "import": "./dist/jxl.js"
    },
    "./pvr": {
      "types": "./dist/pvr.d.ts",
      "import": "./dist/pvr.js"
    },
    "./draco-native": {
      "types": "./dist/draco-native.d.ts",
      "import": "./dist/draco-native.js"
    },
    "./draco-points": {
      "types": "./dist/draco-points.d.ts",
      "import": "./dist/draco-points.js"
    },
    "./bmp": {
      "types": "./dist/bmp.d.ts",
      "import": "./dist/bmp.js"
    },
    "./texture-rgba": {
      "types": "./dist/texture-rgba.d.ts",
      "import": "./dist/texture-rgba.js"
    },
    "./lzfse": {
      "types": "./dist/lzfse.d.ts",
      "import": "./dist/lzfse.js"
    },
    "./snappy": {
      "types": "./dist/snappy.d.ts",
      "import": "./dist/snappy.js"
    },
    "./avif": {
      "types": "./dist/avif.d.ts",
      "import": "./dist/avif.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
