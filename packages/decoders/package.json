{
  "name": "@margoengine/decoders",
  "version": "1.0.0",
  "description": "Worker-pooled Draco geometry and KTX2/Basis texture decoding, and synchronous PNG, TGA, TIFF, DDS and KTX reading, for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "decoders"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/decoders"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js"
    },
    "./tga": {
      "types": "./dist/tga.d.ts",
      "import": "./dist/tga.js"
    },
    "./dds": {
      "types": "./dist/dds.d.ts",
      "import": "./dist/dds.js"
    },
    "./ktx": {
      "types": "./dist/ktx.d.ts",
      "import": "./dist/ktx.js"
    },
    "./tiff": {
      "types": "./dist/tiff.d.ts",
      "import": "./dist/tiff.js"
    },
    "./ktx2-layers": {
      "types": "./dist/ktx2-layers.d.ts",
      "import": "./dist/ktx2-layers.js"
    },
    "./ktx2-hdr": {
      "types": "./dist/ktx2-hdr.d.ts",
      "import": "./dist/ktx2-hdr.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
