{
  "name": "@margoengine/oit",
  "version": "1.0.0",
  "description": "Order-independent transparency for gltf-pro BLEND primitives and materials transparent meshes: weighted blending, moment-based blending, or exact per-pixel layer lists, with no popping between overlapping transparent parts.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "oit"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/oit"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meshes": {
      "types": "./dist/meshes.d.ts",
      "import": "./dist/meshes.js"
    },
    "./exact": {
      "types": "./dist/exact.d.ts",
      "import": "./dist/exact.js"
    },
    "./moments": {
      "types": "./dist/moments.d.ts",
      "import": "./dist/moments.js"
    },
    "./depth": {
      "types": "./dist/depth.d.ts",
      "import": "./dist/depth.js"
    },
    "./vfx": {
      "types": "./dist/vfx.d.ts",
      "import": "./dist/vfx.js"
    },
    "./peel": {
      "types": "./dist/peel.d.ts",
      "import": "./dist/peel.js"
    },
    "./precise": {
      "types": "./dist/precise.d.ts",
      "import": "./dist/precise.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js oit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/oit/test/gpu/meshes-check.mjs && node packages/oit/test/gpu/exact-check.mjs && node packages/oit/test/gpu/moments-check.mjs && node packages/oit/test/gpu/blending-check.mjs && node packages/oit/test/gpu/depth-check.mjs && node packages/oit/test/gpu/vfx-check.mjs && node packages/oit/test/gpu/real-check.mjs && node packages/oit/test/gpu/peel-check.mjs && node packages/oit/test/gpu/precise-check.mjs"
  },
  "peerDependenciesMeta": {
    "@margoengine/materials": {
      "optional": true
    }
  }
}
