{
  "name": "@margoengine/ecs",
  "version": "1.0.0",
  "description": "Typed-array packed sparse-set entity component storage.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "ecs"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/ecs"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./changes": {
      "types": "./dist/changes.d.ts",
      "import": "./dist/changes.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./growable": {
      "types": "./dist/growable.d.ts",
      "import": "./dist/growable.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./relations": {
      "types": "./dist/relations.d.ts",
      "import": "./dist/relations.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "import": "./dist/schedule.js"
    },
    "./objects": {
      "types": "./dist/objects.d.ts",
      "import": "./dist/objects.js"
    },
    "./relation-query": {
      "types": "./dist/relation-query.d.ts",
      "import": "./dist/relation-query.js"
    },
    "./reactive": {
      "types": "./dist/reactive.d.ts",
      "import": "./dist/reactive.js"
    },
    "./serialize": {
      "types": "./dist/serialize.d.ts",
      "import": "./dist/serialize.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/scene": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/scene": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js ecs",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
