{
  "name": "@margoengine/fsm",
  "version": "1.0.0",
  "description": "Hierarchical state machines with history, delayed transitions, parallel regions, JSON documents, snapshots and traces.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "fsm"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/fsm"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parallel": {
      "types": "./dist/parallel.d.ts",
      "import": "./dist/parallel.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./final": {
      "types": "./dist/final.d.ts",
      "import": "./dist/final.js"
    },
    "./invoke": {
      "types": "./dist/invoke.d.ts",
      "import": "./dist/invoke.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js"
    },
    "./scxml": {
      "types": "./dist/scxml.d.ts",
      "import": "./dist/scxml.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js fsm",
    "test": "npm run build && node --test test/*.test.js",
    "test:outside": "node test/outside/check.mjs",
    "prepack": "npm run build",
    "test:browser": "node test/inspect-browser.mjs"
  },
  "margo": {
    "gpuTestTimeoutMinutes": 2
  }
}
