{
  "name": "@margoengine/taa",
  "version": "1.0.0",
  "description": "Optional temporal anti-aliasing with motion vectors and YCoCg history clamping.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "taa"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/taa"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test ../../tests/modern-temporal*.test.js ../../tests/deep-render-jitter.test.js ../../tests/deep-render-taa-failures.test.js test/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "cd ../.. && node packages/taa/test/upscale-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./upscale": {
      "types": "./dist/upscale.d.ts",
      "import": "./dist/upscale.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
