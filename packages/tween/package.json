{
  "name": "@margoengine/tween",
  "version": "1.0.0",
  "description": "Allocation-free numeric tween updates and easing timelines.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "tween"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/tween"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stagger": {
      "types": "./dist/stagger.d.ts",
      "import": "./dist/stagger.js"
    },
    "./motion-path": {
      "types": "./dist/motion-path.d.ts",
      "import": "./dist/motion-path.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.js"
    },
    "./custom-ease": {
      "types": "./dist/custom-ease.d.ts",
      "import": "./dist/custom-ease.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "import": "./dist/props.js"
    },
    "./timeline": {
      "types": "./dist/full-timeline.d.ts",
      "import": "./dist/full-timeline.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "import": "./dist/control.js"
    },
    "./scroll-pin": {
      "types": "./dist/scroll-pin.d.ts",
      "import": "./dist/scroll-pin.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/splines": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js tween",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "cd ../.. && node packages/tween/test/scroll-browser.mjs && node packages/tween/test/scroll-pin-browser.mjs",
    "prepack": "npm run build"
  }
}
