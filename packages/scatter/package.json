{
  "name": "@margoengine/scatter",
  "version": "1.0.0",
  "description": "Seeded instancing, distance-based LOD and procedural wind.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "scatter"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/scatter"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tiles": {
      "types": "./dist/tiles.d.ts",
      "import": "./dist/tiles.js"
    },
    "./paint": {
      "types": "./dist/paint.d.ts",
      "import": "./dist/paint.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./interact": {
      "types": "./dist/interact.d.ts",
      "import": "./dist/interact.js"
    },
    "./imposter": {
      "types": "./dist/imposter.d.ts",
      "import": "./dist/imposter.js"
    },
    "./textured": {
      "types": "./dist/textured.d.ts",
      "import": "./dist/textured.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    },
    "./occlusion": {
      "types": "./dist/occlusion.d.ts",
      "import": "./dist/occlusion.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "import": "./dist/attributes.js"
    },
    "./simplify": {
      "types": "./dist/simplify.d.ts",
      "import": "./dist/simplify.js"
    },
    "./grass": {
      "types": "./dist/grass.d.ts",
      "import": "./dist/grass.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/lod": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/culling": "^1.0.0",
    "@margoengine/mesh-edit": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/lod": {
      "optional": true
    },
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/geometry": {
      "optional": true
    },
    "@margoengine/culling": {
      "optional": true
    },
    "@margoengine/mesh-edit": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js scatter",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "npm run build && node test/lod.browser.mjs",
    "test:browser:edges": "cd ../.. && node packages/scatter/test/edges.browser.mjs",
    "test:browser:repeat": "cd ../.. && node packages/scatter/test/repeat.browser.mjs",
    "test:browser:grass-tiles": "cd ../.. && node packages/scatter/test/grass-tiles.browser.mjs",
    "test:browser:inner": "cd ../.. && node packages/scatter/test/inner.browser.mjs",
    "test:browser:shadow": "cd ../.. && node packages/scatter/test/shadow.browser.mjs",
    "test:browser:shadow-cull": "cd ../.. && node packages/scatter/test/shadow-cull.browser.mjs",
    "test:browser:variation": "cd ../.. && node packages/scatter/test/variation.browser.mjs",
    "test:browser:interact": "cd ../.. && node packages/scatter/test/interact.browser.mjs",
    "test:browser:imposter": "cd ../.. && node packages/scatter/test/imposter.browser.mjs",
    "prepack": "npm run build",
    "test:browser:textured": "cd ../.. && node packages/scatter/test/textured.browser.mjs",
    "test:browser:surface": "cd ../.. && node packages/scatter/test/surface.browser.mjs",
    "test:browser:occlusion": "cd ../.. && node packages/scatter/test/occlusion.browser.mjs",
    "test:browser:attributes": "cd ../.. && node packages/scatter/test/attributes.browser.mjs",
    "test:browser:grass": "cd ../.. && node packages/scatter/test/grass.browser.mjs"
  }
}
