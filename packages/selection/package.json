{
  "name": "@margoengine/selection",
  "version": "1.0.0",
  "description": "GPU picking and visible mesh selection outlines.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "selection"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/selection"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial.d.ts",
      "import": "./dist/spatial.js"
    },
    "./hit-details": {
      "types": "./dist/hit-details.d.ts",
      "import": "./dist/hit-details.js"
    },
    "./xray": {
      "types": "./dist/xray.d.ts",
      "import": "./dist/xray.js"
    },
    "./area": {
      "types": "./dist/area.d.ts",
      "import": "./dist/area.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/bvh": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js selection",
    "test": "npm run build && node --test test/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "node test/picking.browser.mjs && node test/pick-many.browser.mjs && node test/models.browser.mjs && node test/xray.browser.mjs && node test/hit-details.browser.mjs",
    "prepack": "npm run build",
    "test:browser:xray-pulse": "node test/pulse.browser.mjs",
    "test:browser:area": "node test/area.browser.mjs",
    "test:browser:far-origin": "node test/far-origin.browser.mjs",
    "test:browser:highlight": "node test/highlight.browser.mjs"
  },
  "peerDependenciesMeta": {
    "@margoengine/bvh": {
      "optional": true
    }
  }
}
