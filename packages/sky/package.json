{
  "name": "@margoengine/sky",
  "version": "1.0.0",
  "description": "Procedural atmospheric skies, clouds, sun, moon, stars and weather (rain, snow, lightning).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "sky",
    "weather"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/sky"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./preetham": {
      "types": "./dist/preetham.d.ts",
      "import": "./dist/preetham.js"
    },
    "./bruneton": {
      "types": "./dist/bruneton.d.ts",
      "import": "./dist/bruneton.js"
    },
    "./clouds": {
      "types": "./dist/clouds.d.ts",
      "import": "./dist/clouds.js"
    },
    "./night": {
      "types": "./dist/night.d.ts",
      "import": "./dist/night.js"
    },
    "./fog": {
      "types": "./dist/fog.d.ts",
      "import": "./dist/fog.js"
    },
    "./reflection": {
      "types": "./dist/reflection.d.ts",
      "import": "./dist/reflection.js"
    },
    "./lighting": {
      "types": "./dist/lighting.d.ts",
      "import": "./dist/lighting.js"
    },
    "./weather": {
      "types": "./dist/weather.d.ts",
      "import": "./dist/weather.js"
    },
    "./sun": {
      "types": "./dist/sun.d.ts",
      "import": "./dist/sun.js"
    },
    "./volumetric-clouds": {
      "types": "./dist/volumetric-clouds.d.ts",
      "import": "./dist/volumetric-clouds.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js sky",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/sky/test/browser-check.mjs && node packages/sky/test/dither-check.mjs && node packages/sky/test/features-check.mjs"
  }
}
