  "scripts": {
    "build": "node ../../scripts/build-optional.js sky",
    "test": "npm run build && node --test test/*.test.js ../../tests/deep-render-moonlit.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/sky/test/browser-check.mjs && node packages/sky/test/dither-check.mjs && node packages/sky/test/features-check.mjs weather volumetric cloud-shadows && node packages/sky/test/features-check.mjs cloud-bounds lightning-link lightning-bolt && node packages/sky/test/features-check.mjs lightning-glow && node packages/sky/test/features-check.mjs aerial shafts weather-fx && node packages/sky/test/features-check.mjs sleet astro hillaire && node packages/sky/test/features-check.mjs albedo presets coverage && node packages/sky/test/features-check.mjs overcast hurricane tornado && node packages/sky/test/features-check.mjs sheet ground-light && node packages/sky/test/features-check.mjs look settings && node packages/sky/test/seek-check.mjs && node packages/sky/test/sky-add-gltf-check.mjs && node packages/sky/test/sky-environment-check.mjs && node packages/sky/test/sky-light-units-check.mjs && node packages/sky/test/rain-frames-check.mjs && node packages/sky/test/fog-below-check.mjs",
    "test:gpu:night": "cd ../.. && node packages/sky/test/night-check.mjs && node packages/sky/test/moon-gpu.mjs && node packages/sky/test/oblique-gpu.mjs && node packages/sky/test/compat-gpu.mjs && node packages/sky/test/fire-base-gpu.mjs",
    "test:gpu:planet": "cd ../.. && node packages/sciviz/tests/atmosphere-browser.mjs",
    "test:gpu:sky-fog": "cd ../.. && npm run modern:test:sky"
  }
}
