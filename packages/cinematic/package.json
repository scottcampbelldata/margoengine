{
  "name": "@margoengine/cinematic",
  "version": "1.0.0",
  "description": "Critically damped camera follow, look-at and screen shake.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "cinematic"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/cinematic"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brain": {
      "types": "./dist/brain.d.ts",
      "import": "./dist/brain.js"
    },
    "./composer": {
      "types": "./dist/composer.d.ts",
      "import": "./dist/composer.js"
    },
    "./dolly": {
      "types": "./dist/dolly.d.ts",
      "import": "./dist/dolly.js"
    },
    "./group": {
      "types": "./dist/group.d.ts",
      "import": "./dist/group.js"
    },
    "./noise": {
      "types": "./dist/noise.d.ts",
      "import": "./dist/noise.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/splines": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js cinematic",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/cinematic/test/browser-check.mjs"
  }
}
