{
  "name": "@margoengine/ui",
  "version": "1.0.0",
  "description": "Game UI drawn in the engine: menus, HUDs, health bars, inventories, dialogs and toasts with flex layout, theming, keyboard, gamepad and touch navigation, screen reader support and React components.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "ui",
    "hud",
    "game-ui",
    "accessibility"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/ui"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "react-server": "./dist/rsc/react.js",
      "import": "./dist/react.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./markup": {
      "types": "./dist/markup.d.ts",
      "import": "./dist/markup.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/input": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "@margoengine/text": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js ui",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/ui-browser.mjs",
    "prepack": "npm run build",
    "test:browser:world": "npm run build && node tests/world-browser.mjs",
    "test:browser:input": "npm run build && node tests/text-input-browser.mjs",
    "test:browser:image": "npm run build && node tests/image-browser.mjs",
    "test:browser:forms": "npm run build && node tests/forms-browser.mjs"
  }
}
