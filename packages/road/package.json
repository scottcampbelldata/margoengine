{
  "name": "@margoengine/road",
  "version": "0.1.0",
  "description": "Arc-length spline road surfaces, raised curbs and tiled UVs.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "road"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/road"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./junctions": {
      "types": "./dist/junctions.d.ts",
      "import": "./dist/junctions.js"
    },
    "./driving": {
      "types": "./dist/driving.d.ts",
      "import": "./dist/driving.js"
    },
    "./banking": {
      "types": "./dist/banking.d.ts",
      "import": "./dist/banking.js"
    },
    "./terrain": {
      "types": "./dist/terrain.d.ts",
      "import": "./dist/terrain.js"
    },
    "./repair": {
      "types": "./dist/repair.d.ts",
      "import": "./dist/repair.js"
    },
    "./markings": {
      "types": "./dist/markings.d.ts",
      "import": "./dist/markings.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./intersections": {
      "types": "./dist/intersections.d.ts",
      "import": "./dist/intersections.js"
    },
    "./lanes": {
      "types": "./dist/lanes.d.ts",
      "import": "./dist/lanes.js"
    },
    "./geojson": {
      "types": "./dist/geojson.d.ts",
      "import": "./dist/geojson.js"
    },
    "./structures": {
      "types": "./dist/structures.d.ts",
      "import": "./dist/structures.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^0.1.0",
    "@margoengine/splines": "^0.1.0",
    "@margoengine/geometry": "^0.1.0",
    "@margoengine/bvh": "^0.1.0",
    "@margoengine/post": "^0.1.0",
    "@margoengine/compute": "^0.1.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^0.1.0",
    "@margoengine/physics": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/physics": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js road",
    "test": "npm run build && node --test test/*.test.js tests/coupling/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "node test/browser-check.mjs",
    "test:browser:driving": "node test/driving-browser.mjs"
  }
}
