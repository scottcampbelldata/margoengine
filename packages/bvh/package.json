{
  "name": "@margoengine/bvh",
  "version": "1.0.0",
  "description": "Triangle BVH, spatial queries and an engine Raycaster for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "bvh"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/bvh"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "bench": "npm run build && node scripts/bench.js",
    "prepack": "npm run build",
    "bench:models": "npm run build && node scripts/bench-models.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./bake": {
      "types": "./dist/bake.d.ts",
      "import": "./dist/bake.js"
    },
    "./lines": {
      "types": "./dist/lines.d.ts",
      "import": "./dist/lines.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./points": {
      "types": "./dist/points.d.ts",
      "import": "./dist/points.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
