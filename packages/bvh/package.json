{
  "name": "@margoengine/bvh",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Triangle BVH, spatial queries and an engine Raycaster for Margo Engine.",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "bench": "npm run build && node scripts/bench.js",
    "prepack": "npm run build",
    "bench:models": "npm run build && node scripts/bench-models.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./bake": {
      "types": "./dist/bake.d.ts",
      "import": "./dist/bake.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/core": {
      "optional": true
    }
  },
  "homepage": "https://margoengine.com",
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
