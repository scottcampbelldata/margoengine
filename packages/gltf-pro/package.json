{
  "name": "@margoengine/gltf-pro",
  "version": "1.0.0",
  "description": "Opt-in glTF 2.0 metallic-roughness rendering for Margo Engine WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "gltf",
    "pbr"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/gltf-pro"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js ../../tests/modern-extensions.test.js ../../tests/modern-gltf*.test.js ../../tests/gltf-draco-limits.test.js ../../tests/deep-render-pbr-resources.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:shader:browser": "cd ../.. && node packages/gltf-pro/scripts/test-shader-review.js",
    "test:extensions:browser": "cd ../.. && node packages/gltf-pro/scripts/test-extensions-browser.js",
    "test:gpu:materials": "cd ../.. && node scripts/gltf-pro-materials-gpu-check.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model-entry.d.ts",
      "import": "./dist/model-entry.js"
    },
    "./asset": {
      "types": "./dist/asset-entry.d.ts",
      "import": "./dist/asset-entry.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js"
    },
    "./instancing": {
      "types": "./dist/instancing.d.ts",
      "import": "./dist/instancing.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "import": "./dist/prepare.js"
    },
    "./progressive": {
      "types": "./dist/progressive.d.ts",
      "import": "./dist/progressive.js"
    },
    "./splats": {
      "types": "./dist/splats.d.ts",
      "import": "./dist/splats.js"
    },
    "./lights": {
      "types": "./dist/lights.d.ts",
      "import": "./dist/lights.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./interactivity": {
      "types": "./dist/interactivity.d.ts",
      "import": "./dist/interactivity.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./coordinates": {
      "types": "./dist/coordinates.d.ts",
      "import": "./dist/coordinates.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/decoders": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/clustered": "^1.0.0",
    "@margoengine/core": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/physics": "^1.0.0",
    "@margoengine/splats": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/clustered": {
      "optional": true
    },
    "@margoengine/environment": {
      "optional": true
    },
    "@margoengine/geometry": {
      "optional": true
    },
    "@margoengine/physics": {
      "optional": true
    },
    "@margoengine/splats": {
      "optional": true
    }
  },
  "devDependencies": {
    "@margoengine/clustered": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "@margoengine/physics": "^1.0.0",
    "@margoengine/splats": "^1.0.0"
  }
}
