{
  "name": "@margoengine/gltf-pro",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Opt-in glTF 2.0 metallic-roughness rendering for Margo Engine WebGPU.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/gltf-pro"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js ../../tests/modern-extensions.test.js ../../tests/modern-gltf*.test.js ../../tests/gltf-draco-limits.test.js ../../tests/deep-render-pbr-resources.test.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./asset": {
      "types": "./dist/asset-entry.d.ts",
      "import": "./dist/asset-entry.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js"
    },
    "./instancing": {
      "types": "./dist/instancing.d.ts",
      "import": "./dist/instancing.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "import": "./dist/prepare.js"
    },
    "./progressive": {
      "types": "./dist/progressive.d.ts",
      "import": "./dist/progressive.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@margoengine/decoders": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
