{
  "name": "@margoengine/physics",
  "version": "1.0.0",
  "description": "Rigid-body physics for Margo Engine on Rapier: fixed-step engine plugin with interpolation, colliders, joints, queries, events and a character controller.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "physics",
    "rapier"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/physics"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js && node scripts/test-replay.js --browsers=default",
    "test:replay": "npm run build && node scripts/test-replay.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@dimforge/rapier3d-compat": ">=0.14.0 <1"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
