{
  "name": "@margoengine/physics",
  "version": "1.0.0",
  "description": "Rigid-body physics for Margo Engine on its own Rust kernel: fixed-step engine plugin with interpolation, colliders, joints, queries, events, a character controller, vehicles and ropes.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "physics"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/physics"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node scripts/build-oracle.js && node --test tests/*.test.js tests/coupling/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "npm run build && node scripts/test-browser.js && node scripts/test-preview.js && node scripts/test-replay.js --browsers=default",
    "test:replay": "npm run build && node scripts/test-replay.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decomposition": {
      "types": "./dist/decomposition.d.ts",
      "import": "./dist/decomposition.js"
    },
    "./soft": {
      "types": "./dist/soft.d.ts",
      "import": "./dist/soft.js"
    },
    "./meshfiles": {
      "types": "./dist/meshfiles.d.ts",
      "import": "./dist/meshfiles.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "import": "./dist/robots.js"
    },
    "./thermal": {
      "types": "./dist/thermal.d.ts",
      "import": "./dist/thermal.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "import": "./dist/world.js"
    },
    "./earth": {
      "types": "./dist/earth/index.d.ts",
      "import": "./dist/earth.js"
    },
    "./clouds": {
      "types": "./dist/clouds/index.d.ts",
      "import": "./dist/clouds.js"
    },
    "./flight": {
      "types": "./dist/flight.d.ts",
      "import": "./dist/flight.js"
    },
    "./waves": {
      "types": "./dist/waves/index.d.ts",
      "import": "./dist/waves.js"
    },
    "./sea": {
      "types": "./dist/sea/index.d.ts",
      "import": "./dist/sea.js"
    },
    "./seakeeping": {
      "types": "./dist/seakeeping/index.d.ts",
      "import": "./dist/seakeeping.js"
    },
    "./tracers": {
      "types": "./dist/tracers.d.ts",
      "import": "./dist/tracers.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
