    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/physics"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:browser:lava": "cd ../.. && node packages/physics/tests/lava.browser.mjs",
    "test:browser:lightning": "cd ../.. && node packages/physics/tests/lightning.browser.mjs",
    "test:browser:seismic": "cd ../.. && node packages/physics/tests/seismic.browser.mjs",
    "build:airborne": "node scripts/build-airborne-kernel.mjs",
    "build:accretion": "node scripts/build-accretion-kernel.mjs",
    "build:room-sound": "node scripts/build-room-sound-kernel.mjs",
    "build": "node scripts/build.js",
    "test": "npm run build && node scripts/build-oracle.js && node --test tests/*.test.js tests/coupling/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "npm run build && node scripts/test-browser.js && node scripts/test-preview.js && node scripts/test-replay.js --browsers=default",
    "test:replay": "npm run build && node scripts/test-replay.js",
    "prepack": "npm run build"
  },
