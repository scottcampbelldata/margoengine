{
  "name": "@margoengine/scenery",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Procedural moonlit skies and scenery passes for Margo Engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/scenery"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "import": "./dist/sky.js"
    },
    "./sky-moon": {
      "types": "./dist/sky-moon.d.ts",
      "import": "./dist/sky-moon.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "0.1.0"
  },
  "homepage": "https://margoengine.com"
}
