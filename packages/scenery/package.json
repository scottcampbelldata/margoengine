{
  "name": "@margoengine/scenery",
  "version": "1.0.0",
  "description": "Procedural moonlit skies and scenery passes for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "scenery"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/scenery"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test ../../tests/deep-render-scenery.test.js test/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "cd ../.. && node packages/scenery/test/scenery-check.mjs && node packages/scenery/test/moon-gpu.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "import": "./dist/sky.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./scenes": {
      "types": "./dist/scenes.d.ts",
      "import": "./dist/scenes.js"
    },
    "./stars": {
      "types": "./dist/stars.d.ts",
      "import": "./dist/stars.js"
    },
    "./aurora": {
      "types": "./dist/aurora.d.ts",
      "import": "./dist/aurora.js"
    },
    "./moon": {
      "types": "./dist/moon.d.ts",
      "import": "./dist/moon.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/post": "^1.0.0",
    "@margoengine/sky": "^1.0.0",
    "@margoengine/tonemap": "^1.0.0"
  }
}
