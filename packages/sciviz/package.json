    "build:fallback": "node scripts/build-fallback.mjs",
    "build:flow": "node scripts/build-flow.mjs",
    "test:flow-kernel": "node scripts/build-flow.mjs --test",
    "test:fallback-kernel": "node scripts/build-fallback.mjs --test",
