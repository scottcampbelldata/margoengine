{
  "name": "@margoengine/sciviz",
  "version": "1.0.0",
  "description": "Scientific visualisation for Margo Engine: volume rendering with transfer functions, slices and GPU isosurfaces, million-point scatter plots, surface and line plots with axes, ticks, labels and colour bars, and perceptual colour maps.",
  "keywords": [
    "margoengine",
    "webgpu",
    "scientific-visualization",
    "volume-rendering",
    "plot",
    "data-science"
  ],
