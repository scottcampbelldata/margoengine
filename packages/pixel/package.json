{
  "name": "@margoengine/pixel",
  "version": "1.0.0",
  "description": "Pixel art rendering: a pixel camera with integer zoom and parallax, and a layer compositor that scales low-res layers by whole numbers and turns them with every output pixel one source pixel.",
  "keywords": [
    "margoengine",
    "webgpu",
    "2d",
    "pixel-art",
    "parallax"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/pixel"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js"
    },
    "./render3d": {
      "types": "./dist/render3d.d.ts",
      "import": "./dist/render3d.js"
    },
    "./scale": {
      "types": "./dist/scale.d.ts",
      "import": "./dist/scale.js"
    },
    "./follow": {"types": "./dist/follow.d.ts", "import": "./dist/follow.js"},
    "./crt": {
      "types": "./dist/crt.d.ts",
      "import": "./dist/crt.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/cameras": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js pixel",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu": "cd ../.. && node packages/pixel/tests/browser-check.mjs && node packages/pixel/tests/palette-check.mjs && node packages/pixel/tests/render3d-check.mjs && node packages/pixel/tests/scale-check.mjs && node packages/pixel/tests/crt-check.mjs && node packages/pixel/tests/follow-check.mjs",
    "prepack": "npm run build"
  }
}
