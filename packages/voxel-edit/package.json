{
  "name": "@margoengine/voxel-edit",
  "version": "1.0.0",
  "description": "Editing voxel models for editors and tools: dense and sparse grids, modeling operations, brushes and selections, picking, export meshing, .vox scene editing and frame animation.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel",
    "edit"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel-edit"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./sparse": {
      "types": "./dist/sparse.d.ts",
      "import": "./dist/sparse.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./vox": {
      "types": "./dist/vox.d.ts",
      "import": "./dist/vox.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./assist": {
      "types": "./dist/assist.d.ts",
      "import": "./dist/assist.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./smooth": {
      "types": "./dist/smooth.d.ts",
      "import": "./dist/smooth.js"
    },
    "./voxelize": {
      "types": "./dist/voxelize.d.ts",
      "import": "./dist/voxelize.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./rig": {
      "types": "./dist/rig.d.ts",
      "import": "./dist/rig.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "import": "./dist/collab.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./formats-extra": {
      "types": "./dist/formats-extra.d.ts",
      "import": "./dist/formats-extra.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "@margoengine/voxel": "^1.0.0",
    "@margoengine/loaders": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel-edit",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu": "cd ../.. && node packages/voxel-edit/tests/shaders-browser-check.mjs && node packages/voxel-edit/tests/gpu-browser-check.mjs",
    "prepack": "npm run build",
    "test:browser:generate": "cd ../.. && node packages/voxel-edit/tests/generate-browser-check.mjs"
  }
}
