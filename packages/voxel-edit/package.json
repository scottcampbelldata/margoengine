{
  "name": "@margoengine/voxel-edit",
  "version": "1.0.0",
  "description": "Editing voxel models for editors and tools: dense and sparse grids, modeling operations, brushes and selections, picking, export meshing, .vox scene editing and frame animation.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "voxel",
    "edit"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/voxel-edit"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js"
    },
    "./sparse": {
      "types": "./dist/sparse.d.ts",
      "import": "./dist/sparse.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./vox": {
      "types": "./dist/vox.d.ts",
      "import": "./dist/vox.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./assist": {
      "types": "./dist/assist.d.ts",
      "import": "./dist/assist.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0",
    "@margoengine/voxel": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js voxel-edit",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  }
}
