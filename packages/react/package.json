    "@margoengine/text": "^0.1.0 || ^1.0.0",
    "@margoengine/post": "^0.1.0 || ^1.0.0",
    "@margoengine/dof": "^0.1.0 || ^1.0.0",
    "@margoengine/tonemap": "^0.1.0 || ^1.0.0",
    "@margoengine/taa": "^0.1.0 || ^1.0.0",
    "@margoengine/physics": "^0.1.0 || ^1.0.0",
