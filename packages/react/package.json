{
  "name": "@margoengine/react",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "React 18/19 components and stable mesh refs for Margo Engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test tests/*.test.js test/*.test.js",
    "test:browser": "node scripts/test-scene-browser.js",
    "test:after-scene": "node scripts/test-after-scene-browser.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./post": {
      "types": "./dist/post.d.ts",
      "import": "./dist/post.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "margoengine": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/animation": "^1.0.0",
    "@margoengine/animator": "^1.0.0",
    "@margoengine/selection": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/controls": "^1.0.0",
    "@margoengine/shadows": "^1.0.0",
    "@margoengine/html": "^1.0.0",
    "@margoengine/fbx": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/gizmo": "^1.0.0",
    "@margoengine/sky": "^1.0.0",
    "@margoengine/text": "^1.0.0",
    "@margoengine/post": "^1.0.0",
    "@margoengine/dof": "^1.0.0",
    "@margoengine/tonemap": "^1.0.0",
    "@margoengine/taa": "^1.0.0",
    "@margoengine/physics": "^1.0.0",
    "@dimforge/rapier3d-compat": ">=0.14.0 <1",
    "@margoengine/xr": "^1.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
