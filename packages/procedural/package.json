{
  "name": "@margoengine/procedural",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Procedural cabins, foliage, grass, humanoids, Marching Cubes surfaces and seeded 3D noise.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/geometry": "0.1.0",
    "isosurface": "1.0.0",
    "simplex-noise": "4.0.3"
  },
  "peerDependencies": {
    "@margoengine/core": "^0.1.0 || ^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js procedural",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
