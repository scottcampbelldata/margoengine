{
  "name": "@margoengine/procedural",
  "version": "1.0.0",
  "description": "Procedural cabins, foliage, grass, humanoids, Marching Cubes surfaces, seeded 2D/3D/4D noise, L-systems, Voronoi fracture and a bounded voxel expression language.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "procedural"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/procedural"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./poisson": {
      "types": "./dist/poisson.d.ts",
      "import": "./dist/poisson.js"
    },
    "./standin": {
      "types": "./dist/standin.d.ts",
      "import": "./dist/standin.js"
    },
    "./noise": {
      "types": "./dist/noise.d.ts",
      "import": "./dist/noise.js"
    },
    "./lsystem": {
      "types": "./dist/lsystem.d.ts",
      "import": "./dist/lsystem.js"
    },
    "./voronoi": {
      "types": "./dist/voronoi.d.ts",
      "import": "./dist/voronoi.js"
    },
    "./expression": {
      "types": "./dist/expression.d.ts",
      "import": "./dist/expression.js"
    },
    "./dungeon": {
      "types": "./dist/dungeon.d.ts",
      "import": "./dist/dungeon.js"
    },
    "./trees": {
      "types": "./dist/trees.d.ts",
      "import": "./dist/trees.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "import": "./dist/sdf.js"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "import": "./dist/textures.js"
    },
    "./buildings": {
      "types": "./dist/buildings.d.ts",
      "import": "./dist/buildings.js"
    },
    "./caves": {
      "types": "./dist/caves.d.ts",
      "import": "./dist/caves.js"
    },
    "./tree-mesh": {
      "types": "./dist/tree-mesh.d.ts",
      "import": "./dist/tree-mesh.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js procedural && node scripts/copy-poisson.mjs && node scripts/copy-dungeon.mjs && node scripts/copy-trees.mjs && node scripts/copy-sdf.mjs && node scripts/copy-buildings.mjs && node scripts/copy-caves.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "build:poisson": "node scripts/build-poisson.mjs",
    "test:poisson-kernel": "node scripts/build-poisson.mjs --test",
    "test:gpu": "node test/poisson-browser.mjs && node test/textures-browser.mjs && node test/caves-browser.mjs && node test/tree-mesh-browser.mjs",
    "prepack": "npm run build",
    "build:dungeon": "node scripts/build-dungeon.mjs",
    "test:dungeon-kernel": "node scripts/build-dungeon.mjs --test",
    "build:trees": "node scripts/build-trees.mjs",
    "test:trees-kernel": "node scripts/build-trees.mjs --test",
    "build:sdf": "node scripts/build-sdf.mjs",
    "test:sdf-kernel": "node scripts/build-sdf.mjs --test",
    "build:buildings": "node scripts/build-buildings.mjs",
    "test:buildings-kernel": "node scripts/build-buildings.mjs --test",
    "build:caves": "node scripts/build-caves.mjs",
    "test:caves-kernel": "node scripts/build-caves.mjs --test"
  }
}
