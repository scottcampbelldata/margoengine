{
  "name": "@margoengine/procedural",
  "version": "1.0.0",
  "description": "Procedural cabins, foliage, grass, humanoids, Marching Cubes surfaces, seeded 2D/3D/4D noise, L-systems, Voronoi fracture and a bounded voxel expression language.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "procedural"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/procedural"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standin": {
      "types": "./dist/standin.d.ts",
      "import": "./dist/standin.js"
    },
    "./noise": {
      "types": "./dist/noise.d.ts",
      "import": "./dist/noise.js"
    },
    "./lsystem": {
      "types": "./dist/lsystem.d.ts",
      "import": "./dist/lsystem.js"
    },
    "./voronoi": {
      "types": "./dist/voronoi.d.ts",
      "import": "./dist/voronoi.js"
    },
    "./expression": {
      "types": "./dist/expression.d.ts",
      "import": "./dist/expression.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js procedural",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
