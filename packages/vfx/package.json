{
  "name": "@margoengine/vfx",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "GPU particle simulation and indirect billboards.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/vfx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js vfx",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./obstacles": {
      "types": "./dist/obstacles.d.ts",
      "import": "./dist/obstacles.js"
    },
    "./wrap": {
      "types": "./dist/wrap.d.ts",
      "import": "./dist/wrap.js"
    },
    "./sort": {
      "types": "./dist/sort.d.ts",
      "import": "./dist/sort.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "0.1.0"
  },
  "homepage": "https://margoengine.com"
}
