{
  "name": "@margoengine/vfx",
  "version": "1.0.0",
  "description": "GPU particle simulation and indirect billboards, with curves over life and sphere, cone and mesh-surface emitters.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "vfx"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/vfx"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js vfx",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu": "cd ../.. && node packages/vfx/test/browser-check.mjs && node packages/vfx/test/features-check.mjs && node packages/vfx/test/lit-check.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./obstacles": {
      "types": "./dist/obstacles.d.ts",
      "import": "./dist/obstacles.js"
    },
    "./wrap": {
      "types": "./dist/wrap.d.ts",
      "import": "./dist/wrap.js"
    },
    "./sort": {
      "types": "./dist/sort.d.ts",
      "import": "./dist/sort.js"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js"
    },
    "./soft": {
      "types": "./dist/soft.d.ts",
      "import": "./dist/soft.js"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js"
    },
    "./emitter": {
      "types": "./dist/emitter.d.ts",
      "import": "./dist/emitter.js"
    },
    "./ribbons": {
      "types": "./dist/ribbons.d.ts",
      "import": "./dist/ribbons.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "import": "./dist/lit.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
