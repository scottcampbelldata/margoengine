{
  "name": "@margoengine/machinery",
  "version": "1.0.0",
  "description": "Kinematics, closed-form mechanism poses, sections, metrology, clearance, assemblies, exploded views, feature edges, dimensions, spatial queries, surface transport and telemetry for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "cad",
    "kinematics",
    "sections",
    "metrology"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/machinery"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js machinery",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/machinery/test/dimensions-check.mjs && node packages/machinery/test/edges-check.mjs && node packages/machinery/test/section-open-check.mjs && node packages/machinery/test/bench-check.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kinematics": {
      "types": "./dist/kinematics.d.ts",
      "import": "./dist/kinematics.js"
    },
    "./mechanisms": {
      "types": "./dist/mechanisms.d.ts",
      "import": "./dist/mechanisms.js"
    },
    "./rigs": {
      "types": "./dist/rigs.d.ts",
      "import": "./dist/rigs.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./section": {
      "types": "./dist/section.d.ts",
      "import": "./dist/section.js"
    },
    "./assembly": {
      "types": "./dist/assembly.d.ts",
      "import": "./dist/assembly.js"
    },
    "./metrology": {
      "types": "./dist/metrology.d.ts",
      "import": "./dist/metrology.js"
    },
    "./spatial": {
      "types": "./dist/spatial.d.ts",
      "import": "./dist/spatial.js"
    },
    "./clearance": {
      "types": "./dist/clearance.d.ts",
      "import": "./dist/clearance.js"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js"
    },
    "./bench": {
      "types": "./dist/bench.d.ts",
      "import": "./dist/bench.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js"
    },
    "./exploded": {
      "types": "./dist/exploded.d.ts",
      "import": "./dist/exploded.js"
    },
    "./edges": {
      "types": "./dist/edges.d.ts",
      "import": "./dist/edges.js"
    },
    "./dimensions": {
      "types": "./dist/dimensions.d.ts",
      "import": "./dist/dimensions.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/cad": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/lines": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "@margoengine/physics": "^1.0.0",
    "@margoengine/text": "^1.0.0"
  }
}
