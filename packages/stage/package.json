{
  "name": "@margoengine/stage",
  "version": "0.1.0",
  "description": "The stage: createStage mounts a canvas, camera controls and rendering in five lines. Re-exported by margoengine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "renderer",
    "scene"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/stage"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test ../../tests/modern-wrapper.test.js ../../tests/modern-facade-lifecycle.test.js ../../tests/deep-stage-sphere.test.js ../../tests/modern-silent-facade-drops.test.js ../../tests/deep-ingestion-camera-controls-initialization.test.js tests/*.test.js",
    "test:gpu": "cd ../.. && node scripts/stage-viewer-gpu-check.js && node packages/stage/test/gpu/scene-check.mjs",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu:features": "cd ../.. && node scripts/stage-features-gpu-check.js",
    "test:gpu:gltf": "cd ../.. && node scripts/run-with-timeout.mjs --max=5 -- node packages/stage/test/gpu/gltf-check.mjs",
    "test:gpu:lights": "cd ../.. && node scripts/run-with-timeout.mjs --max=4 -- node packages/stage/test/gpu/lights-check.mjs",
    "test:gpu:viewer-extras": "cd ../.. && node packages/stage/test/gpu/viewer-extras-check.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gltf": {
      "types": "./dist/gltf.d.ts",
      "import": "./dist/gltf.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "import": "./dist/sky.js"
    },
    "./particles": {
      "types": "./dist/particles.d.ts",
      "import": "./dist/particles.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./shadows": {
      "types": "./dist/shadows.d.ts",
      "import": "./dist/shadows.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./lights": {
      "types": "./dist/lights.d.ts",
      "import": "./dist/lights.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./viewer-extras": {
      "types": "./dist/viewer-extras.d.ts",
      "import": "./dist/viewer-extras.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/core": "^0.1.0"
  },
  "peerDependencies": {
    "@margoengine/gltf": "^0.1.0",
    "@margoengine/creative": "^0.1.0",
    "@margoengine/sky": "^0.1.0",
    "@margoengine/environment": "^0.1.0",
    "@margoengine/shadows": "^0.1.0",
    "@margoengine/xr": "^0.1.0",
    "@margoengine/studio": "^0.1.0",
    "@margoengine/tonemap": "^0.1.0",
    "@margoengine/physics": "^0.1.0",
    "@margoengine/save": "^0.1.0",
    "@margoengine/animation": "^0.1.0",
    "@margoengine/clustered": "^0.1.0",
    "@margoengine/labels": "^0.1.0",
    "@margoengine/selection": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/animation": {
      "optional": true
    },
    "@margoengine/clustered": {
      "optional": true
    },
    "@margoengine/gltf": {
      "optional": true
    },
    "@margoengine/creative": {
      "optional": true
    },
    "@margoengine/sky": {
      "optional": true
    },
    "@margoengine/environment": {
      "optional": true
    },
    "@margoengine/shadows": {
      "optional": true
    },
    "@margoengine/xr": {
      "optional": true
    },
    "@margoengine/studio": {
      "optional": true
    },
    "@margoengine/tonemap": {
      "optional": true
    },
    "@margoengine/physics": {
      "optional": true
    },
    "@margoengine/save": {
      "optional": true
    },
    "@margoengine/labels": {
      "optional": true
    },
    "@margoengine/selection": {
      "optional": true
    }
  }
}
