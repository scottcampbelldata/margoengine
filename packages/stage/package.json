{
  "name": "@margoengine/stage",
  "version": "1.0.0",
  "description": "The stage: createStage mounts a canvas, camera controls and rendering in five lines. Re-exported by margoengine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "renderer",
    "scene"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/stage"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test ../../tests/modern-wrapper.test.js ../../tests/modern-facade-lifecycle.test.js ../../tests/deep-stage-sphere.test.js ../../tests/modern-silent-facade-drops.test.js tests/*.test.js",
    "test:gpu": "cd ../.. && node scripts/stage-viewer-gpu-check.js",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gltf": {
      "types": "./dist/gltf.d.ts",
      "import": "./dist/gltf.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "import": "./dist/sky.js"
    },
    "./particles": {
      "types": "./dist/particles.d.ts",
      "import": "./dist/particles.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./shadows": {
      "types": "./dist/shadows.d.ts",
      "import": "./dist/shadows.js"
    },
    "./xr": {
      "types": "./dist/xr.d.ts",
      "import": "./dist/xr.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "peerDependencies": {
    "@margoengine/gltf": "^1.0.0",
    "@margoengine/creative": "^1.0.0",
    "@margoengine/scenery": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/shadows": "^1.0.0",
    "@margoengine/xr": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/staging": "^1.0.0",
    "@margoengine/tonemap": "^1.0.0",
    "@margoengine/physics": "^1.0.0",
    "@dimforge/rapier3d-compat": ">=0.14.0 <1",
    "@margoengine/save": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/gltf": {
      "optional": true
    },
    "@margoengine/creative": {
      "optional": true
    },
    "@margoengine/scenery": {
      "optional": true
    },
    "@margoengine/environment": {
      "optional": true
    },
    "@margoengine/shadows": {
      "optional": true
    },
    "@margoengine/xr": {
      "optional": true
    },
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/staging": {
      "optional": true
    },
    "@margoengine/tonemap": {
      "optional": true
    },
    "@margoengine/physics": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "@margoengine/save": {
      "optional": true
    }
  }
}
