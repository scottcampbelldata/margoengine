{
  "name": "@margoengine/environment",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "HDR/EXR loading, image-based lighting (prefiltered specular, SH irradiance, BRDF LUT) and environment backgrounds for Margo Engine on WebGPU.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/vexel.git",
    "directory": "packages/environment"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/environment.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^0.1.0 || ^1.0.0"
  }
}
