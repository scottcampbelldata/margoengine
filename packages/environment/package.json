{
  "name": "@margoengine/environment",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "HDR/EXR/UltraHDR loading, image-based lighting (prefiltered specular, SH irradiance, BRDF LUT) applied to meshes and glTF models, environment and color backgrounds, and scene fog for Margo Engine on WebGPU.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/environment"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/environment.test.js tests/scene.test.js tests/volumetric.test.js tests/probes.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./probes": {
      "types": "./dist/probes.d.ts",
      "import": "./dist/probes.js"
    },
    "./volumetric": {
      "types": "./dist/volumetric.d.ts",
      "import": "./dist/volumetric.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
