{
  "name": "@margoengine/environment",
  "version": "1.0.0",
  "description": "HDR/EXR/UltraHDR loading, EXR writing, image-based lighting (prefiltered specular, SH irradiance, BRDF LUT), environment backgrounds and scene fog for Margo Engine on WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "environment"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/environment"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js ../../examples/package-benchmarks/proofs/package-guard.mjs",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build",
    "test:probes:browser": "npm run build && node scripts/test-browser.js --probe-samples",
    "test:blend:browser": "npm run build && node scripts/test-browser.js --page=blend",
    "test:ground:browser": "npm run build && node scripts/test-browser.js --page=ground",
    "test:gi:browser": "npm run build && node scripts/test-browser.js --page=gi",
    "test:visibility:browser": "npm run build && node scripts/test-browser.js --page=visibility",
    "test:fog-volumes:browser": "npm run build && node scripts/test-browser.js --page=fog-volumes",
    "test:density-volume:browser": "npm run build && node scripts/test-browser.js --page=density-volume && node scripts/test-browser.js --page=density-volume --compat",
    "test:studio:browser": "npm run build && node scripts/test-browser.js --page=studio",
    "test:prefiltered:browser": "npm run build && node scripts/test-browser.js --page=prefiltered",
    "test:reflector-pbr:browser": "npm run build && node scripts/test-browser.js --page=reflector-pbr",
    "test:mesh-reflector:browser": "npm run build && node scripts/test-browser.js --page=mesh-reflector",
    "test:lightformer:browser": "npm run build && node scripts/test-browser.js --page=lightformer",
    "test:exr-codecs:browser": "npm run build && node scripts/test-browser.js --page=exr-codecs",
    "test:exr-codecs-bundled:browser": "node tests/exr-codecs-bundled-browser.mjs",
    "test:probe-capture:browser": "npm run build && node scripts/test-browser.js --page=probe-capture",
    "test:sky-occlusion:browser": "npm run build && node scripts/test-browser.js --page=sky-occlusion",
    "test:fog-transparent:browser": "npm run build && node scripts/test-browser.js --page=volumetric-transparent",
    "test:fog-route:browser": "npm run build && node scripts/test-browser.js --page=volumetric-route",
    "test:fog-beam:browser": "npm run build && node scripts/test-browser.js --page=volumetric-beam",
    "test:fog-beam-continuity:browser": "npm run build && node scripts/test-browser.js --page=volumetric-beam-continuity && node scripts/test-browser.js --page=volumetric-beam-continuity --compat",
    "test:reflection-shapes:browser": "npm run build && node scripts/test-browser.js --page=reflection-shapes",
    "test:bright:browser": "npm run build && node scripts/test-browser.js --page=bright",
    "test:gpu:mirror": "cd ../.. && node scripts/env-mirror-gpu-check.js && node scripts/env-mirror-gpu-check.js --compat && node packages/environment/tests/review56-browser.mjs && node packages/environment/tests/review56-browser.mjs --compat && node packages/environment/tests/capture-stability-browser.mjs && node packages/environment/tests/capture-stability-browser.mjs --compat && node packages/environment/tests/cube-source-restore-browser.mjs && node packages/environment/tests/cube-source-restore-browser.mjs --compat",
    "test:gpu:fog-all": "cd ../.. && node scripts/fog-all-gpu-check.js",
    "test:fog-far:browser": "npm run build && cd ../.. && node packages/environment/tests/volumetric-far.browser.mjs && node packages/environment/tests/volumetric-far.browser.mjs --compat",
    "test:settings:browser": "npm run build && cd ../.. && node packages/environment/tests/settings.browser.mjs && node packages/environment/tests/settings.browser.mjs --compat"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./probes": {
      "types": "./dist/probes.d.ts",
      "import": "./dist/probes.js"
    },
    "./volumetric": {
      "types": "./dist/volumetric.d.ts",
      "import": "./dist/volumetric.js"
    },
    "./reflector": {
      "types": "./dist/reflector.d.ts",
      "import": "./dist/reflector.js"
    },
    "./refractor": {
      "types": "./dist/refractor.d.ts",
      "import": "./dist/refractor.js"
    },
    "./cube-camera": {
      "types": "./dist/cube-camera.d.ts",
      "import": "./dist/cube-camera.js"
    },
    "./exr-write": {
      "types": "./dist/exr-write.d.ts",
      "import": "./dist/exr-write.js"
    },
    "./exr-tiled": {
      "types": "./dist/exr-tiled.d.ts",
      "import": "./dist/exr-tiled.js"
    },
    "./blend": {
      "types": "./dist/blend.d.ts",
      "import": "./dist/blend.js"
    },
    "./ground": {
      "types": "./dist/ground.d.ts",
      "import": "./dist/ground.js"
    },
    "./gi": {
      "types": "./dist/gi.d.ts",
      "import": "./dist/gi.js"
    },
    "./fog-volumes": {
      "types": "./dist/fog-volumes.d.ts",
      "import": "./dist/fog-volumes.js"
    },
    "./density-volume": {
      "types": "./dist/density-volume.d.ts",
      "import": "./dist/density-volume.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    },
    "./prefiltered": {
      "types": "./dist/prefiltered.d.ts",
      "import": "./dist/prefiltered.js"
    },
    "./reflector-pbr": {
      "types": "./dist/reflector-pbr.d.ts",
      "import": "./dist/reflector-pbr.js"
    },
    "./lightformer": {
      "types": "./dist/lightformer.d.ts",
      "import": "./dist/lightformer.js"
    },
    "./exr-codecs": {
      "types": "./dist/exr-codecs.d.ts",
      "import": "./dist/exr-codecs.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "import": "./dist/loaders.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  }
}
