{
  "name": "@margoengine/animation",
  "version": "1.0.0",
  "description": "Storage-buffer skinning and compute morph targets for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "animation"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/animation"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js test/*.test.js ../../tests/modern-extensions.test.js ../../tests/deep-interaction-animation-resources.test.js",
    "test:gpu": "cd ../.. && node scripts/animation-batched-deformation-tests.js",
    "test:gpu:morph": "cd ../.. && node scripts/animation-morph-gpu-tests.js",
    "test:gpu:dqs": "cd ../.. && node scripts/animation-dqs-tests.js",
    "test:gpu:instanced-skin": "cd ../.. && node scripts/animation-instanced-skin-tests.js",
    "test:gpu:geometry-cache": "cd ../.. && node scripts/animation-geometry-cache-tests.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu:mixer": "cd ../.. && node packages/animation/tests/mixer-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vat": {
      "types": "./dist/vat.d.ts",
      "import": "./dist/vat.js"
    },
    "./sampling": {
      "types": "./dist/sampling.d.ts",
      "import": "./dist/sampling.js"
    },
    "./pointer": {
      "types": "./dist/pointer.d.ts",
      "import": "./dist/pointer.js"
    },
    "./interactivity": {
      "types": "./dist/interactivity.d.ts",
      "import": "./dist/interactivity.js"
    },
    "./skeleton-utils": {
      "types": "./dist/skeleton-utils.d.ts",
      "import": "./dist/skeleton-utils.js"
    },
    "./morph-gpu": {
      "types": "./dist/morph-gpu.d.ts",
      "import": "./dist/morph-gpu.js"
    },
    "./lod": {
      "types": "./dist/lod.d.ts",
      "import": "./dist/lod.js"
    },
    "./clip-utils": {
      "types": "./dist/clip-utils.d.ts",
      "import": "./dist/clip-utils.js"
    },
    "./dqs": {
      "types": "./dist/dqs.d.ts",
      "import": "./dist/dqs.js"
    },
    "./instanced-skin": {
      "types": "./dist/instanced-skin.d.ts",
      "import": "./dist/instanced-skin.js"
    },
    "./geometry-cache": {
      "types": "./dist/geometry-cache.d.ts",
      "import": "./dist/geometry-cache.js"
    },
    "./point-cache": {
      "types": "./dist/point-cache.d.ts",
      "import": "./dist/point-cache.js"
    },
    "./mixer": {
      "types": "./dist/mixer.d.ts",
      "import": "./dist/mixer.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/selection": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/selection": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
