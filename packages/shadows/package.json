{
  "name": "@margoengine/shadows",
  "version": "1.0.0",
  "description": "Four-cascade cached directional shadows with PCSS.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "shadows"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/shadows"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js ../../tests/modern-game.test.js ../../tests/modern-shadow-texture-transform.test.js",
    "test:gpu": "cd ../.. && node packages/shadows/test/lit-faces-browser.mjs",
    "test:gpu:colored": "cd ../.. && node packages/shadows/test/colored-browser.mjs",
    "test:gpu:distance": "cd ../.. && node packages/shadows/test/distance-browser.mjs",
    "test:gpu:cutout-casters": "cd ../.. && node packages/shadows/test/cutout-casters-browser.mjs",
    "test:gpu:light-function": "cd ../.. && node packages/shadows/test/light-function-browser.mjs",
    "test:gpu:outside": "cd ../.. && node packages/shadows/test/outside/check.mjs",
    "test:gpu:transmission": "cd ../.. && node packages/shadows/test/transmission-browser.mjs",
    "test:gpu:vsm": "cd ../.. && node packages/shadows/test/vsm-browser.mjs",
    "test:gpu:virtual-custom": "cd ../.. && node packages/shadows/test/virtual-custom-browser.mjs",
    "test:gpu:virtual": "cd ../.. && node packages/shadows/test/virtual-sampling-browser.mjs",
    "test:gpu:virtual-feedback": "cd ../.. && node packages/shadows/test/virtual-feedback-browser.mjs",
    "test:gpu:virtual-cache": "cd ../.. && node packages/shadows/test/virtual-cache-browser.mjs",
    "test:gpu:virtual-filters": "cd ../.. && node packages/shadows/test/lit-faces-browser.mjs --page=virtual && node packages/shadows/test/virtual-edges-browser.mjs",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:gpu:rt-alpha": "cd ../.. && node packages/shadows/test/rt-alpha-browser.mjs",
    "test:gpu:rt-alpha-attach": "cd ../.. && node packages/shadows/test/rt-alpha-attach-browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./light-function": {
      "types": "./dist/light-function.d.ts",
      "import": "./dist/light-function.js"
    },
    "./vsm": {
      "types": "./dist/vsm.d.ts",
      "import": "./dist/vsm.js"
    },
    "./transmission": {
      "types": "./dist/transmission.d.ts",
      "import": "./dist/transmission.js"
    },
    "./distance": {
      "types": "./dist/distance.d.ts",
      "import": "./dist/distance.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./rt": {
      "types": "./dist/rt.d.ts",
      "import": "./dist/rt.js"
    },
    "./rt-alpha": {
      "types": "./dist/rt-alpha.d.ts",
      "import": "./dist/rt-alpha.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/bvh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
