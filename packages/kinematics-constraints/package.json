{
  "name": "@margoengine/kinematics-constraints",
  "version": "1.0.0",
  "description": "Standalone analytical capsule, sphere and convex hull constraints for IK target and arm clearance.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "kinematics",
    "constraints"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/kinematics-constraints"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./joint-limits": {
      "types": "./dist/joint-limits.d.ts",
      "import": "./dist/joint-limits.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js"
    },
    "./swept": {
      "types": "./dist/swept.d.ts",
      "import": "./dist/swept.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "import": "./dist/sdf.js"
    },
    "./multi-goal": {
      "types": "./dist/multi-goal.d.ts",
      "import": "./dist/multi-goal.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:gpu:multi-goal": "cd ../.. && node packages/kinematics-constraints/tests/multi-goal-browser.mjs",
    "build": "node ../../scripts/build-optional.js kinematics-constraints",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "node ../../scripts/test-kinematics-constraints-browser.js",
    "test:limits:browser": "cd ../.. && node packages/kinematics-constraints/tests/limits-browser.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@margoengine/bvh": "^1.0.0",
    "@margoengine/geometry": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/bvh": {
      "optional": true
    },
    "@margoengine/geometry": {
      "optional": true
    }
  }
}
