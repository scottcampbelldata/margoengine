{
  "name": "@margoengine/xr",
  "version": "1.0.0",
  "description": "Optional WebGPU WebXR sessions, input poses and stereo rendering for Margo Engine, with real-device runs (./device-check).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "webxr",
    "vr",
    "ar"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/xr"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js xr",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "test:gpu:pointers": "cd ../.. && node packages/xr/tests/pointer.browser.mjs",
    "test:gpu:locomotion": "cd ../.. && node packages/xr/tests/locomotion.browser.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device-check": {
      "types": "./dist/device-check.d.ts",
      "import": "./dist/device-check.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./ar": {
      "types": "./dist/ar.d.ts",
      "import": "./dist/ar.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./pointer": {
      "types": "./dist/pointer.d.ts",
      "import": "./dist/pointer.js"
    },
    "./locomotion": {
      "types": "./dist/locomotion.d.ts",
      "import": "./dist/locomotion.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/selection": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/selection": {
      "optional": true
    }
  },
  "margo": {
    "gpuTestTimeoutMinutes": {
      "test:gpu:pointers": 3,
      "test:gpu:locomotion": 3
    }
  }
}
