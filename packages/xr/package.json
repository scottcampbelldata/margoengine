{
  "name": "@margoengine/xr",
  "version": "1.0.0",
  "description": "Optional WebGPU WebXR sessions, input poses and stereo rendering for Margo Engine, with real-device runs (./device-check).",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "webxr",
    "vr",
    "ar"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/xr"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js xr",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device-check": {
      "types": "./dist/device-check.d.ts",
      "import": "./dist/device-check.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
