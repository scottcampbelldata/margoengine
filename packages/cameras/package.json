{
  "name": "@margoengine/cameras",
  "version": "1.0.0",
  "description": "Orthographic projection and exactly vertical (top-down) views for the core camera, with matching culling and picking.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "cameras"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/cameras"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./origin": {
      "types": "./dist/origin.d.ts",
      "import": "./dist/origin.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./offaxis": {
      "types": "./dist/offaxis.d.ts",
      "import": "./dist/offaxis.js"
    },
    "./physical": {
      "types": "./dist/physical.d.ts",
      "import": "./dist/physical.js"
    },
    "./panini": {
      "types": "./dist/panini.d.ts",
      "import": "./dist/panini.js"
    },
    "./wide-cube": {
      "types": "./dist/wide-cube.d.ts",
      "import": "./dist/wide-cube.js"
    },
    "./panorama": {
      "types": "./dist/panorama.d.ts",
      "import": "./dist/panorama.js"
    },
    "./stereo": {
      "types": "./dist/stereo.d.ts",
      "import": "./dist/stereo.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/post": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/environment": {
      "optional": true
    },
    "@margoengine/post": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js cameras",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "test:gpu": "cd ../.. && node packages/cameras/test/browser-check.mjs",
    "test:browser:panorama": "cd ../.. && node packages/cameras/test/panorama-browser.mjs",
    "test:browser:stereo": "cd ../.. && node packages/cameras/test/stereo-browser.mjs"
  }
}
