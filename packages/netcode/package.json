{
  "name": "@margoengine/netcode",
  "version": "0.1.0",
  "description": "Game networking for any game: schema-first binary codec with delta snapshots, an authoritative fixed-timestep server, client prediction and reconciliation, interpolation and a loopback network for tests.",
  "keywords": [
    "margoengine",
    "netcode",
    "multiplayer",
    "networking",
    "prediction"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/netcode"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rollback": {
      "types": "./dist/rollback.d.ts",
      "import": "./dist/rollback.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./webrtc": {
      "types": "./dist/webrtc.d.ts",
      "import": "./dist/webrtc.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./rooms": {
      "types": "./dist/rooms.d.ts",
      "import": "./dist/rooms.js"
    },
    "./smoothing": {
      "types": "./dist/smoothing.d.ts",
      "import": "./dist/smoothing.js"
    },
    "./webtransport": {
      "types": "./dist/webtransport.d.ts",
      "import": "./dist/webtransport.js"
    },
    "./signal": {
      "types": "./dist/signal.d.ts",
      "import": "./dist/signal.js"
    },
    "./extrapolate": {
      "types": "./dist/extrapolate.d.ts",
      "import": "./dist/extrapolate.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.js"
    },
    "./hitboxes": {
