    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./lobby": {
      "types": "./dist/lobby.d.ts",
      "import": "./dist/lobby.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./generate-rust": {
      "types": "./dist/generate-rust.d.ts",
      "import": "./dist/generate-rust.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
