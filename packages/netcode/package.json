    "access": "public"
  },
  "dependencies": {
    "@margoengine/math": "^0.1.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js netcode",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/browser/signal.mjs",
    "prepack": "npm run build"
  }
