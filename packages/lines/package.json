{
  "name": "@margoengine/lines",
  "version": "1.0.0",
  "description": "Fat lines (Line, LineMaterial) and debug helpers for Margo Engine, WebGPU.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "lines"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/lines"
  },
  "license": "MIT",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/lines.test.js tests/fog.test.js tests/clipping.test.js tests/skeleton-helper.test.js tests/helpers.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
