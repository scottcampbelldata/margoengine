    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./caustics": {
      "types": "./dist/caustics.d.ts",
      "import": "./dist/caustics.js"
    },
    "./ripples": {
      "types": "./dist/ripples.d.ts",
