    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "import": "./dist/flow.js"
    },
    "./bodies": {
      "types": "./dist/bodies.d.ts",
      "import": "./dist/bodies.js"
    },
    "./scatter": {
      "types": "./dist/scatter.d.ts",
      "import": "./dist/scatter.js"
    },
