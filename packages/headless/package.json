{
  "name": "@margoengine/headless",
  "version": "1.0.0",
  "description": "Render without a browser page: a stand-in canvas for core, GPU globals from the WebGPU binding you pass in, and readback to RGBA pixels or PNG bytes.",
  "keywords": [
    "margoengine",
    "webgpu",
    "headless",
    "node",
    "thumbnail",
    "png"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/headless"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frames": {
      "types": "./dist/frames.d.ts",
      "import": "./dist/frames.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./ffmpeg": {
      "types": "./dist/ffmpeg.d.ts",
      "import": "./dist/ffmpeg.js"
    },
    "./ffmpeg-files": {
      "types": "./dist/ffmpeg-files.d.ts",
      "import": "./dist/ffmpeg-files.js"
    },
    "./stage": {
      "types": "./dist/stage.d.ts",
      "import": "./dist/stage.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./tiles": {
      "types": "./dist/tiles.d.ts",
      "import": "./dist/tiles.js"
    },
    "./accumulate": {
      "types": "./dist/accumulate.d.ts",
      "import": "./dist/accumulate.js"
    },
    "./null": {
      "types": "./dist/null.d.ts",
      "import": "./dist/null.js"
    },
    "./gif": {
      "types": "./dist/gif.d.ts",
      "import": "./dist/gif.js"
    },
    "./look": {
      "types": "./dist/look.d.ts",
      "import": "./dist/look.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/stage": "^1.0.0",
    "@margoengine/environment": "^1.0.0",
    "@margoengine/exporters": "^1.0.0",
    "@margoengine/post": "^1.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js headless",
    "test": "npm run build && node --test tests/*.test.js",
    "test:real-ffmpeg": "npm run build && node scripts/test-real-ffmpeg.mjs && node scripts/test-real-ffmpeg-files.mjs",
    "test:gpu": "cd ../.. && node packages/headless/tests/browser-check.mjs && node packages/headless/tests/node-check.mjs && node packages/headless/tests/transparent-gpu.mjs",
    "prepack": "npm run build",
    "test:gpu:gif": "cd ../.. && node packages/headless/tests/gif-gpu.mjs",
    "test:gpu:tiles": "cd ../.. && node packages/headless/tests/tiles-gpu.mjs",
    "test:gpu:accumulate": "cd ../.. && node packages/headless/tests/accumulate-gpu.mjs"
  },
  "peerDependenciesMeta": {
    "@margoengine/stage": {
      "optional": true
    },
    "@margoengine/environment": {
      "optional": true
    },
    "@margoengine/exporters": {
      "optional": true
    },
    "@margoengine/post": {
      "optional": true
    }
  },
  "dependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
