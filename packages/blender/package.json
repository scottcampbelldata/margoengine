{
  "name": "@margoengine/blender",
  "version": "1.0.0",
  "description": "Optional offline Blender .margo assets using Margo's WebGPU PBR renderer.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "blender"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/blender"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "FORMAT.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anim": {
      "types": "./dist/anim.d.ts",
      "import": "./dist/anim.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./pbr-ext": {
      "types": "./dist/pbr-ext.d.ts",
      "import": "./dist/pbr-ext.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js"
    },
    "./ktx2": {
      "types": "./dist/ktx2.d.ts",
      "import": "./dist/ktx2.js"
    },
    "./objects": {
      "types": "./dist/objects.d.ts",
      "import": "./dist/objects.js"
    },
    "./lightmap": {
      "types": "./dist/lightmap.d.ts",
      "import": "./dist/lightmap.js"
    },
    "./meshopt": {
      "types": "./dist/meshopt.d.ts",
      "import": "./dist/meshopt.js"
    },
    "./nodes": {
      "types": "./dist/nodes.d.ts",
      "import": "./dist/nodes.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prepack": "npm --prefix ../.. run build:packages",
    "test:browser:objects": "node tests/objects-browser.mjs",
    "test:browser:lightmap": "node tests/lightmap-browser.mjs",
    "test:browser:meshopt": "node tests/meshopt-browser.mjs",
    "test:browser:nodes": "node tests/nodes-browser.mjs"
  },
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/exporters": "^1.0.0",
    "@margoengine/lightmap": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@margoengine/decoders": {
      "optional": true
    },
    "@margoengine/exporters": {
      "optional": true
    },
    "@margoengine/lightmap": {
      "optional": true
    }
  }
}
