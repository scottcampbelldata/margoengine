{
  "name": "@margoengine/mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol server for Margo Engine: AI coding tools (Claude, Cursor, Copilot) search the docs and API, read a package, list the examples and type-check a snippet against the real package types. Plain stdio JSON-RPC, no dependencies.",
  "keywords": [
    "margoengine",
    "mcp",
    "model-context-protocol",
    "ai",
    "llms"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/mcp"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "sideEffects": false,
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/inspector": "^1.0.0",
    "@margoengine/loaders": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/materials": "^1.0.0",
    "@margoengine/environment": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/core": {
      "optional": true
    },
    "@margoengine/inspector": {
      "optional": true
    },
    "@margoengine/loaders": {
      "optional": true
    },
    "@margoengine/gltf-pro": {
      "optional": true
    },
    "@margoengine/materials": {
      "optional": true
    },
    "@margoengine/environment": {
      "optional": true
    }
  },
  "bin": {
    "margoengine-mcp": "./bin/margoengine-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./porting": {
      "types": "./dist/porting.d.ts",
      "import": "./dist/porting.js"
    },
    "./error-codes": {
      "types": "./dist/error-codes.d.ts",
      "import": "./dist/error-codes.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./live-host": {
      "types": "./dist/live-host.d.ts",
      "import": "./dist/live-host.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./assets-page": {
      "types": "./dist/assets-page.d.ts",
      "import": "./dist/assets-page.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-optional.js mcp && node scripts/build-corpus.mjs",
    "test": "npm run build && node --test tests/*.test.js",
    "test:gpu": "cd ../.. && node packages/mcp/tests/render-gpu-check.mjs",
    "prepack": "npm run build",
    "test:browser:live": "cd ../.. && node packages/mcp/tests/live-browser.mjs",
    "test:browser:live:compat": "cd ../.. && node packages/mcp/tests/live-browser.mjs --compat",
    "test:browser:assets": "cd ../.. && node packages/mcp/tests/assets-browser.mjs"
  }
}
