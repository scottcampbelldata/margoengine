{
  "name": "@margoengine/creative",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "WebGPU particles, atmosphere, toon shading and post-processing for Margo Engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/creative"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/planet.test.js tests/particles.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "dev": "vite --config vite.config.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./particles": {
      "types": "./dist/particles.d.ts",
      "import": "./dist/particles.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js"
    },
    "./toon": {
      "types": "./dist/toon.d.ts",
      "import": "./dist/toon.js"
    },
    "./post": {
      "types": "./dist/post.d.ts",
      "import": "./dist/post.js"
    },
    "./grass": {
      "types": "./dist/grass.d.ts",
      "import": "./dist/grass.js"
    },
    "./planet": {
      "types": "./dist/planet.d.ts",
      "import": "./dist/planet.js"
    },
    "./stars": {
      "types": "./dist/stars.d.ts",
      "import": "./dist/stars.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@margoengine/core": "0.1.0"
  },
  "dependencies": {
    "@margoengine/vfx": "0.1.0"
  },
  "homepage": "https://margoengine.com",
  "devDependencies": {
    "@margoengine/math": "0.1.0"
  }
}
