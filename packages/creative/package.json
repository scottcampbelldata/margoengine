{
  "name": "@margoengine/creative",
  "version": "1.0.0",
  "description": "WebGPU particles, atmosphere, toon shading and post-processing for Margo Engine.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "creative"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/creative"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test tests/*.test.js ../../tests/modern-grass.test.js ../../tests/deep-render-creative.test.js ../../tests/audit-rendering-composition.test.js",
    "test:browser": "npm run build && node scripts/test-browser.js",
    "dev": "vite --config vite.config.js",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./particles": {
      "types": "./dist/particles.d.ts",
      "import": "./dist/particles.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js"
    },
    "./toon": {
      "types": "./dist/toon.d.ts",
      "import": "./dist/toon.js"
    },
    "./post": {
      "types": "./dist/post.d.ts",
      "import": "./dist/post.js"
    },
    "./grass": {
      "types": "./dist/grass.d.ts",
      "import": "./dist/grass.js"
    },
    "./planet": {
      "types": "./dist/planet.d.ts",
      "import": "./dist/planet.js"
    },
    "./stars": {
      "types": "./dist/stars.d.ts",
      "import": "./dist/stars.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0"
  },
  "dependencies": {
    "@margoengine/vfx": "^1.0.0"
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
