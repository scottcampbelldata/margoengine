{
  "name": "@margoengine/animator",
  "version": "1.0.0",
  "description": "Blend trees, additive layers, animation states, foot IK, CCD IK chains, root motion, and look-at and aim constraints.",
  "keywords": [
    "margoengine",
    "webgpu",
    "3d",
    "animator"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "packages/animator"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js ../../tests/modern-animator*.test.js ../../tests/modern-game.test.js",
    "test:gpu": "cd ../.. && node packages/animator/test/scene-owner-browser.mjs && node packages/animator/test/layers-browser.mjs",
    "test:avoidance:browser": "node test/avoidance-browser.mjs",
    "prepack": "npm --prefix ../.. run build:packages"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./inertialize": {
      "types": "./dist/inertialize.d.ts",
      "import": "./dist/inertialize.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./warping": {
      "types": "./dist/warping.d.ts",
      "import": "./dist/warping.js"
    },
    "./fbik": {
      "types": "./dist/fbik.d.ts",
      "import": "./dist/fbik.js"
    },
    "./motion-matching": {
      "types": "./dist/motion-matching.d.ts",
      "import": "./dist/motion-matching.js"
    },
    "./mirror": {
      "types": "./dist/mirror.d.ts",
      "import": "./dist/mirror.js"
    },
    "./spline-ik": {
      "types": "./dist/spline-ik.d.ts",
      "import": "./dist/spline-ik.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./blend-trees": {
      "types": "./dist/blend-trees.d.ts",
      "import": "./dist/blend-trees.js"
    },
    "./masks": {
      "types": "./dist/masks.d.ts",
      "import": "./dist/masks.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/animation": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/splines": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@margoengine/splines": {
      "optional": true
    }
  },
  "devDependencies": {
    "@margoengine/math": "^1.0.0"
  }
}
