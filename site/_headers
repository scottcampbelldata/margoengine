# Security headers for every page and worker; docs/deploying.md explains each directive. Checked with scripts/csp-check.mjs.
# No file needs a rule of its own: the decoder worker (the Orrery's Draco) runs without eval.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache

# The catalog examples run inline scripts against packages on jsDelivr and esm.sh, so they keep no CSP.
/catalog/examples/*
  ! Content-Security-Policy

# The playground page keeps a strict policy: its own scripts only, no inline script, no other host. The visitor's code
# runs in /playground/frame/, loaded as <iframe sandbox="allow-scripts"> (an opaque origin), which alone gets the loose
# policy the code needs: inline import map, blob modules, jsDelivr, https: for models and textures (docs/playground.md).
# `sandbox allow-scripts` keeps the frame an opaque origin even when it is opened on its own or framed some other way.
/playground/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
/playground/frame/*
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts; default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https: blob: data:; worker-src 'self' blob: https://cdn.jsdelivr.net; font-src 'self' https:; media-src 'self' https: blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Cache-Control: no-cache above: browsers check every file each visit (an unchanged file costs a 304, nothing is
# re-downloaded), so a bad copy never sticks. It also overrides the zone's 4-hour Browser Cache TTL on margoengine.com.
# Missing files get site/404.html with no-store; scripts/site-check.mjs checks all of this after each deploy.
