# Cloudflare Pages and Netlify read this file from the build output (Vite copies public/ into dist/).
# Why each directive is there, and the Vercel and Nginx versions: https://github.com/scottcampbelldata/margoengine/blob/main/docs/deploying.md
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints everything in assets/, so a changed file gets a new name: cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
