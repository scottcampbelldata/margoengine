{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "files": [
    "cli.js",
    "cad-cli.js",
    "convert.js",
    "pipeline/cli.js",
    "pipeline/build.js",
    "pipeline/optimize.js",
    "pipeline/presets.js",
    "pipeline/gltf-io.js",
    "pipeline/passes.js",
    "pipeline/meshopt-encode.js"
  ]
}
