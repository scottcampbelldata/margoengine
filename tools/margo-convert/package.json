{
  "name": "margo-convert",
  "version": "1.0.0",
  "description": "Offline asset pipeline for Margo Engine: margo-convert build ./assets --preset web",
  "keywords": [
    "asset-pipeline",
    "cli",
    "converter",
    "gltf",
    "margoengine",
    "meshopt",
    "optimize",
    "webgpu",
    "webp",
    "3d"
  ],
  "homepage": "https://margoengine.com",
  "bugs": {
    "url": "https://github.com/scottcampbelldata/margoengine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "tools/margo-convert"
  },
  "license": "Apache-2.0",
  "author": "Scott Campbell",
  "type": "module",
  "bin": {
    "margo-convert": "cli.js"
  },
  "exports": {
    "./build": "./pipeline/build.js",
    "./optimize": "./pipeline/optimize.js",
    "./presets": "./pipeline/presets.js"
  },
  "sideEffects": false,
  "files": [
    "cli.js",
    "pipeline",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/decoders": "^1.0.0",
    "@margoengine/exporters": "^1.0.0",
    "@margoengine/geometry": "^1.0.0",
    "@margoengine/gltf-pro": "^1.0.0",
    "@margoengine/headless": "^1.0.0",
    "@margoengine/math": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
