    "cli.js",
    "convert.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@margoengine/core": "^1.0.0",
    "@margoengine/exporters": "^1.0.0",
    "@margoengine/machinery": "^1.0.0",
    "@margoengine/math": "^1.0.0",
    "occt-import-js": "0.0.23"
  },
  "homepage": "https://margoengine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcampbelldata/margoengine.git",
    "directory": "tools/margo-convert"
  },
  "publishConfig": {
    "access": "public"
  }
}
