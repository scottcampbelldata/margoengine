{
  "name": "margo-convert",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Offline STEP / IGES / BREP to GLB converter for Margo Engine: npx margo-convert part.step part.glb",
  "bin": {
    "margo-convert": "cli.js"
  },
  "exports": {
    ".": "./convert.js"
  },
