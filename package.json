{
  "name": "margoengine",
  "homepage": "https://margoengine.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/gltf",
    "packages/gltf-pro",
    "packages/blender",
    "packages/animation",
    "packages/post",
    "packages/shadows",
    "packages/clustered",
    "packages/vfx",
    "packages/animator",
    "packages/dof",
    "packages/tonemap",
    "packages/taa",
    "packages/splats",
    "packages/terrain",
    "packages/react",
    "packages/xr",
    "packages/usdz",
    "packages/ifc",
    "packages/loaders",
    "packages/exporters",
    "packages/machinery",
    "packages/creative",
    "packages/scenery",
    "packages/margoengine",
    "packages/bvh",
    "packages/lines",
    "packages/environment",
    "packages/geometry",
    "packages/decoders",
    "packages/text",
    "packages/controls",
    "packages/points",
    "packages/audio",
    "packages/physics",
    "packages/labels",
    "packages/stats",
    "packages/inspector",
    "packages/gizmo",
    "packages/usdz-export",
    "packages/tween",
    "packages/ecs",
    "packages/fsm",
    "packages/splines",
    "packages/net",
    "packages/cinematic",
    "packages/input",
    "packages/wfc",
    "packages/procedural",
    "packages/navigation",
    "packages/fbx",
    "packages/navmesh",
    "packages/road",
    "packages/transitions",
    "packages/toon",
    "packages/water",
    "packages/sky",
    "packages/selection",
    "packages/scatter",
    "packages/html",
    "packages/video",
    "examples/vite",
    "examples/gameplay-sandbox",
    "examples/react-viewer",
    "examples/next",
    "apps/showcase-night-citadel"
  ],
  "scripts": {
    "catalog": "node scripts/serve-catalog.js",
    "dev:sandbox": "vite examples/gameplay-sandbox",
    "build:packages": "node scripts/build-modern.js --precompiled && npm run build --workspace packages --if-present",
    "measure:size": "node scripts/measure-size.js",
    "pack:packages": "npm run build:packages && npm pack --workspace packages --ignore-scripts --pack-destination test-results",
    "package:blender": "python tools/blender-addon/package_addon.py",
    "modern:build": "node scripts/build-modern.js",
    "modern:test": "node --experimental-test-module-mocks --test tests/modern*.test.js",
    "modern:test:browser": "node scripts/modern-browser-tests.js",
    "modern:test:domains": "node scripts/modern-domain-tests.js",
    "modern:test:sky": "node scripts/modern-sky-moon-tests.js",
    "modern:test:citadel": "node scripts/modern-night-citadel-tests.js",
    "modern:test:machinery": "node scripts/modern-machinery-runtime-tests.js",
    "modern:bench:machinery": "node scripts/modern-machinery-benchmark.js",
    "modern:bench:sky": "node scripts/modern-sky-moon-benchmark.js",
    "modern:test:finalization": "node scripts/modern-finalization-tests.js",
    "modern:check:conveyor": "node scripts/modern-conveyor-checks.js",
    "modern:test:packages": "node scripts/modern-package-tests.js",
    "modern:test:wrapper": "node scripts/modern-wrapper-tests.js",
    "modern:test:hardware": "node scripts/modern-hardware-gpu-tests.js",
    "modern:test:stress": "node scripts/modern-stress-tests.js",
    "modern:test:stress:aggregate": "node scripts/aggregate-stress.js",
    "test:release": "npm run test:all && npm run measure:size && npm run modern:build:starters && npm run modern:build:showcase && npm run test:modules:packages && npm run modern:test:game:packages && npm run modern:test:interop:packages && npm run modern:test:postfx:packages && npm run modern:test:browser && npm run modern:test:wrapper && npm run modern:test:domains && npm run modern:test:game && npm run modern:test:extensions && npm run modern:test:postfx:browser && npm run modern:test:xr:browser && npm run modern:test:usdz:browser && npm run test:modules:browser && npm run modern:test:stress -- --sessions=500 --frames=120",
    "modern:test:extensions": "node scripts/modern-extension-tests.js",
    "modern:test:blender": "node scripts/modern-blender-tests.js",
    "modern:test:interop": "node --test packages/xr/tests/*.test.js packages/ifc/tests/*.test.js packages/loaders/tests/usdz.test.js packages/exporters/tests/usdz.test.js",
    "modern:test:xr:browser": "node scripts/modern-xr-tests.js",
    "modern:test:react": "node --experimental-test-module-mocks --test packages/react/tests/*.test.js packages/react/test/*.test.js",
    "modern:test:usdz": "node --test packages/usdz/tests/*.test.js",
    "modern:test:usdz:browser": "node scripts/modern-usdz-tests.js",
    "benchmark:three-vs-margo": "node scripts/benchmark-three-vs-margo.js",
    "benchmark:demo-loads": "node scripts/benchmark-demo-loads.js",
    "modern:test:interop:packages": "node scripts/modern-interop-packages.js",
    "modern:dev": "npm run dev --workspace @margoengine/starter-vite",
    "modern:dev:extensions": "npm run build:packages && vite --host 127.0.0.1",
    "modern:dev:showcase": "npm run dev --workspace @margoengine/showcase-night-citadel",
    "modern:build:showcase": "npm run build --workspace @margoengine/showcase-night-citadel",
    "modern:build:starters": "npm run build --workspace @margoengine/starter-vite && npm run build --workspace @margoengine/starter-next",
    "predev": "npm run build:packages",
    "dev": "npm run modern:dev:showcase",
    "build": "npm run build:packages && npm run modern:build:starters && npm run modern:build:showcase",
    "pretest": "npm run build:packages",
    "test": "npm run modern:test",
    "test:all": "npm run build:packages && node --experimental-test-module-mocks --test tests/*.test.js packages/*/tests/*.test.js packages/*/test/*.test.js",
    "test:modules:browser": "node scripts/margo-module-tests.js",
    "test:modules:packages": "node scripts/margo-package-tests.js",
    "test:browser": "node scripts/modern-browser-tests.js",
    "modern:test:game": "node scripts/modern-game-tests.js",
    "modern:test:game:packages": "node scripts/modern-game-package-tests.js",
    "modern:test:postfx": "node --test packages/dof/tests/*.test.js packages/tonemap/tests/*.test.js",
    "modern:test:postfx:packages": "node scripts/modern-postfx-packages.js",
    "modern:test:postfx:browser": "node scripts/modern-postfx-tests.js",
    "predev:sandbox": "npm run build:packages",
    "release:check": "npm run test:all && npm run measure:size && npm run test:modules:packages && npm run modern:test:postfx:packages",
    "publish:packages": "npm run release:check && npm publish --workspace packages --ignore-scripts --access public",
    "catalog:build": "node scripts/build-catalog.js",
    "build:site": "npm run catalog:build && node scripts/build-site.js"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "binaryen": "132.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "26.1.0",
    "occt-import-js": "0.0.23",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-ifc": "0.0.78"
  }
}
