{
  "name": "vexel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/gltf",
    "packages/react",
    "packages/machinery",
    "packages/creative",
    "packages/loaders",
    "packages/exporters",
    "packages/bvh",
    "packages/lines",
    "packages/environment",
    "packages/geometry",
    "packages/decoders",
    "packages/text",
    "packages/controls",
    "packages/points",
    "packages/audio",
    "packages/physics",
    "packages/stats",
    "packages/inspector",
    "packages/gizmo",
    "packages/usdz-export",
    "packages/tween",
    "packages/ecs",
    "packages/fsm",
    "packages/splines",
    "packages/net",
    "packages/cinematic",
    "packages/input",
    "packages/wfc",
    "packages/procedural",
    "packages/navigation",
    "packages/fbx",
    "packages/navmesh",
    "packages/road",
    "packages/transitions",
    "packages/toon",
    "packages/water",
    "packages/sky",
    "packages/selection",
    "packages/scatter",
    "packages/html",
    "packages/video",
    "examples/vite",
    "examples/next"
  ],
  "scripts": {
    "build:packages": "node scripts/build-modern.js --precompiled && npm run build --workspace packages --if-present",
    "pack:packages": "npm run build:packages && npm pack --workspace packages --ignore-scripts --pack-destination test-results",
    "modern:build": "node scripts/build-modern.js",
    "modern:test": "node --test tests/modern*.test.js",
    "modern:test:browser": "node scripts/modern-browser-tests.js",
    "modern:test:domains": "node scripts/modern-domain-tests.js",
    "modern:test:finalization": "node scripts/modern-finalization-tests.js",
    "modern:check:conveyor": "node scripts/modern-conveyor-checks.js",
    "modern:test:packages": "node scripts/modern-package-tests.js",
    "modern:dev": "npm run dev --workspace @vexel/starter-vite",
    "modern:build:starters": "npm run build --workspace @vexel/starter-vite && npm run build --workspace @vexel/starter-next",
    "predev": "npm run build:packages",
    "dev": "npm run modern:dev",
    "build": "npm run build:packages && npm run modern:build:starters",
    "pretest": "npm run build:packages",
    "test": "npm run modern:test",
    "test:browser": "node scripts/modern-browser-tests.js",
    "test:all": "npm run build:packages && node --experimental-test-module-mocks --test tests/*.test.js packages/*/tests/*.test.js packages/*/test/*.test.js",
    "test:modules:browser": "node scripts/margo-module-tests.js",
    "test:modules:packages": "node scripts/margo-package-tests.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "binaryen": "132.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/three": "0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "26.1.0",
    "three": "0.186.1"
  }
}
