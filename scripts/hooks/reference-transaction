#!/bin/sh
# NEVER MORE THAN 6 IN THE QUEUE (Scott, 2026-11-01). Installed by scripts/setup-merge-drivers.mjs into the shared hooks
# folder. Refuses a new local branch when 6 besides main exist. Updating or deleting a branch always passes, so a rebase,
# a push and the cleanup that brings the count down are never stopped.
[ "$1" = prepared ] || exit 0
zero='^0+$'
new=0
while read -r old value ref; do
  case "$ref" in
    refs/heads/main) continue ;;
    refs/heads/*) ;;
    *) continue ;;
  esac
  echo "$value" | grep -Eq "$zero" && continue
  git show-ref --verify --quiet "$ref" && continue
  new=$((new + 1))
done
[ "$new" = 0 ] && exit 0
count=$(git for-each-ref --format='%(refname)' refs/heads | grep -cv '^refs/heads/main$')
[ $((count + new)) -le 6 ] && exit 0
{
  echo '========================================================================'
  echo "NEVER MORE THAN 6 IN THE QUEUE: $count branches besides main already exist."
  echo 'This new branch is refused. Land or delete one first.'
  echo 'Rule: AGENTS.md and the playbook, Scott 2026-11-01.'
  echo '========================================================================'
} >&2
exit 1
